@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Mark pins with moments

Container_Boundary(web, "Mondino web app") {
  Component(page, "GlobePage", "Angular page, mondino application", "Builds the markers for the viewer")
  Component(store, "TeamStore", "domain pins/", "Holds the pins and their moments")
  Component(cache, "SettingsCache", "domain storage/", "Holds the viewer's chosen kinds")
  Component(marker, "markerFor", "domain moments/", "Chooses a pin's nearest moment in the next 7 days")
  Component(emblem, "emblemFor", "domain moments/", "Chooses a held emblem or the icon of the kind")
  Component(view, "GlobeView", "globe library, mo-globe", "Takes pins and markers as inputs")
  Component(layer, "PinLayer", "globe library", "Draws the moment marker beside each pin; each pin's accessible name gives it as text")
}
Container(api, "Mondino API", "ASP.NET Core", "EmblemCatalogue sets each moment's emblem key")

Rel(store, api, "Reads pins through TEAM_API", "JSON/HTTPS")
Rel(page, store, "Reads pins")
Rel(page, cache, "Reads the chosen kinds")
Rel(page, marker, "Calls for each pin")
Rel(marker, emblem, "Calls for the chosen moment")
Rel(page, view, "Passes pins and markers")
Rel(view, layer, "Draws with")
@enduml
