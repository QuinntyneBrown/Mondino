@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Mark pins with moments

Container_Boundary(web, "Mondino web app") {
  Component(page, "GlobePage", "Angular page, mondino application", "Works out each pin's view, its marker among it, for the viewer")
  Component(store, "TeamStore", "mondino team/", "Holds the pins and the team's moments")
  Component(cache, "SettingsCache", "domain storage/, SETTINGS_STORE", "Holds the viewer's chosen kinds")
  Component(views, "pinViews", "domain pins/", "What each pin shows, once a minute")
  Component(marker, "markerFor", "domain moments/", "Chooses a pin's moments in the next 7 days, nearest first")
  Component(layer, "PinLayer", "components", "Draws each pin; its accessible name gives the marker as text")
  Component(mm, "MomentMarker", "components", "The sun disc with the kind's icon or a count")
}
Container(api, "Mondino API", "ASP.NET Core", "Gives the team's moments; EmblemCatalogue sets no emblem key")

Rel(store, api, "Reads pins and moments through TEAM_API", "JSON/HTTPS")
Rel(page, store, "Reads pins and moments")
Rel(page, cache, "Reads the chosen kinds")
Rel(page, views, "Calls once a minute")
Rel(views, marker, "Calls for each pin")
Rel(page, layer, "Passes the placements")
Rel(layer, mm, "Draws beside a marked pin")
@enduml
