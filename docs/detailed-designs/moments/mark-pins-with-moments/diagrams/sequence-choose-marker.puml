@startuml
title UML sequence behaviour — Choose a marker and its emblem for a pin
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobePage" as page
  participant "TeamStore" as store
  participant "SettingsCache" as settings
  participant "pinViews" as views
  participant "markerFor" as marker
  participant "PinLayer" as layer
end box
box "Backend — Mondino API" #D1FADF
  participant "TeamsController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "GetMomentsQueryHandler" as handler
  participant "EmblemCatalogue" as catalogue
end box

actor -> page : Open the Globe screen
page -> store : Read pins and moments
store -> controller : GET /api/teams/{teamId}/moments
controller -> handler : Send GetMomentsQuery
handler -> catalogue : KeyFor(subject) for each moment
catalogue --> handler : No key: Mondino holds no emblem (ADR 0019)
handler --> controller : Moments, one for each teammate
controller --> store : Moments
store --> page : Pins and moments signals
page -> settings : Read the viewer's chosen kinds
settings --> page : momentKinds (all four at first, L2-022)
page -> views : pinViews(pins, now, ..., moments, kinds)
loop each pin
  views -> marker : markerFor(the teammate's moments, kinds, now)
  marker -> marker : Drop moments of a kind turned off (L2-022)
  marker -> marker : Keep moments today or in the next 7 days,\nin each moment's own place (L2-021)
  alt no moment left
    marker --> views : No marker
  else at least one moment
    marker --> views : MarkerView: the nearest one's kind, title and when,\nthe count and the today flag
  end
  views -> views : The accessible name ends with the marker's words
end
views --> page : PinViews
page -> layer : Placements of the pins
alt one moment this week
  layer --> actor : Marker in sun with the kind's icon (L2-021)
else two or more
  layer --> actor : Marker in sun with the count, "2" (L2-021)
end
layer --> actor : Larger and ringed when the nearest moment is today
actor -> layer : Point at, focus or select a marked pin
layer --> actor : Pin lifts; its label gives the nearest moment's title\nand when label as text (L2-021)
@enduml
