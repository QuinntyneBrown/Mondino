@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Mark pins with moments

enum MomentKind {
  holiday
  formula-1
  local-event
  sport
}

interface Moment {
  +teammateId: string
  +timeZoneId: string
  +kind: MomentKind
  +title: string
  +date: string
  +emblemKey: string | null
}

interface SettingsStore <<api, SETTINGS_STORE>> {
  +momentKinds: Signal<MomentKind[]>
}

class SettingsCache <<domain storage/>> {
  +momentKinds: Signal<MomentKind[]>
}

interface MarkerView {
  +kind: MomentKind
  +title: string
  +when: string
  +count: number
  +today: boolean
  +spoken: string
}

interface PinView {
  +teammateId: string
  +description: string
  +marker: MarkerView | null
}

class "moments/ (domain)" as moments <<functions>> {
  +markerFor(moments: Moment[], kinds: MomentKind[], now: number): MarkerView | null
  +daysUntil(date: string, timeZoneId: string, now: number): number
  +whenLabel(date: string, daysAhead: number): string
}

class "pins/ (domain)" as pins <<functions>> {
  +pinViews(pins, now, ..., moments: Moment[], kinds: MomentKind[]): Map<string, PinView>
  +describePin(..., marker: MarkerView | null): string
}

class EmblemCatalogue <<backend>> {
  +KeyFor(subject: string?): string?
}

class GlobePage {
  -views: Signal<Map<string, PinView>>
}

class PinLayer {
  +placements: PinPlacement[]
}

class MomentMarker <<components>> {
  +marker: MarkerView
}

class PinLabel {
  +pin: PinView
}

class MomentIcon {
  +kind: MomentKind
}

SettingsCache ..|> SettingsStore
GlobePage ..> SettingsStore : reads momentKinds
GlobePage ..> pins : calls pinViews
pins ..> moments : calls markerFor
moments ..> Moment : reads
moments ..> MarkerView : returns
PinView --> MarkerView
Moment --> MomentKind
EmblemCatalogue ..> Moment : sets no emblemKey (ADR 0019)
GlobePage --> PinLayer : passes placements
PinLayer --> MomentMarker : draws beside a pin
PinLayer --> PinLabel : draws the lifted label
MomentMarker ..> MomentIcon : the kind's icon, one moment
PinLabel ..> MomentIcon : the nearest moment's line
@enduml
