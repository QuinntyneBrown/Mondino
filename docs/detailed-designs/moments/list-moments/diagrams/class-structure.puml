@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — List moments

enum MomentKind {
  holiday
  formula1
  localEvent
  sport
}

interface Moment {
  +kind: MomentKind
  +title: string
  +date: string
  +detail: string
  +emblemKey: string | null
  +teammateId: string
  +teammateName: string
  +cityName: string
  +countryCode: string
  +timeZoneId: string
}

interface TeamApi {
  +getPins(teamId: string, signal: AbortSignal): Promise<TeamPins>
  +getMoments(teamId: string, signal: AbortSignal): Promise<Moment[]>
}

class HttpTeamApi

interface Clock {
  +now(): Date
  +minute: Signal<Date>
}

interface DatedMoment {
  +key: string
  +teammateId: string
  +kind: MomentKind
  +kindName: string
  +title: string
  +detail: string
  +cityName: string
  +when: string
  +weekday: string
  +day: number
  +month: string
  +firstName: string
  +initials: string
  +colour: string
  +who: string
}

interface MomentWindowView {
  +from: number
  +to: number
  +before: number
  +after: number
}

interface MomentGroups {
  +today: DatedMoment[]
  +thisWeek: DatedMoment[]
  +later: DatedMoment[]
}

class "moments/ (domain)" as moments <<functions>> {
  +groupMoments(moments: Moment[], pins: Pin[], now: number): MomentGroups
  +daysAheadLabel(daysAhead: number): string
  +daysUntil(date: string, timeZoneId: string, now: number): number
  +momentWindow(total: number, start: number): MomentWindowView
  +followWindow(total: number, start: number, first: number, last: number): number
  +windowGroups(groups: MomentGroups, view: MomentWindowView): MomentGroups
}

class MomentsPage {
  -filter: Signal<MomentKind | 'everything'>
  -groups: Signal<MomentGroups>
  -start: Signal<number>
  +chooseFilter(filter): void
  +choose(teammateId: string): void
  +tryAgain(): void
}

class FilterChips {
  +chips: FilterChip[]
  +selected: string
  +selectedChange: Output<string>
}

class MomentList {
  +groups: MomentGroups
  +address: (teammateId) => string
  +teammateChosen: Output<string>
}

class MomentRow {
  +moment: DatedMoment
  +address: string
  +chosen: Output<void>
}

class TodayMoment {
  +moment: DatedMoment
  +address: string
  +chosen: Output<void>
}

class TeamStore {
  +team: Signal<TeamPins>
  +moments: Signal<Moment[]>
  +momentsState: Signal<'Loading' | 'Ready' | 'Failed'>
  +loadMoments(): Promise<void>
}

HttpTeamApi ..|> TeamApi
TeamStore --> TeamApi : TEAM_API
MomentsPage --> Clock : CLOCK
MomentsPage ..> moments : calls groupMoments
MomentsPage --> FilterChips
MomentsPage --> MomentList
MomentsPage --> TeamStore : reads moments, pins and momentsState
MomentList "1" --> "*" MomentRow
MomentList "1" --> "*" TodayMoment
moments ..> MomentGroups : returns
moments ..> MomentWindowView : returns
MomentGroups "1" --> "*" DatedMoment
DatedMoment --> Moment
Moment --> MomentKind
@enduml
