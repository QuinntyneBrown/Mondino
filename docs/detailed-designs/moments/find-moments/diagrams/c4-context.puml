@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Find moments

Person(teammate, "Teammate", "A person on a team")
System(mondino, "Mondino", "Shows a team on a 3D globe with local time, weather and moments")
System_Ext(holidays, "OpenHolidays API", "Public holidays of a country and its subdivisions, ODbL (ADR 0019)")

Rel(teammate, mondino, "Reads the team's moments using")
Rel(mondino, holidays, "Asks for a country's holidays of a year", "HTTPS")
@enduml
