@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Find moments

Container_Boundary(api, "Mondino API") {
  Component(ctrl, "TeamsController", "ASP.NET Core controller", "Exposes GET /api/teams/{teamId}/moments")
  Component(handler, "GetMomentsQueryHandler", "MediatR handler", "Reads the team's cities and names each moment's teammate")
  Component(finder, "MomentFinder", "Application service", "Decides which moments belong to a city")
  Component(emblems, "EmblemCatalogue", "Application service", "Gives an emblem key where Mondino holds the right")
  Component(own, "MondinoCalendar", "Infrastructure, embedded JSON", "Mondino's own holidays, races, events and fixtures")
  Component(holidays, "HolidayCalendar", "Infrastructure", "Mondino's own holidays and the public ones, its own kept")
  Component(cache, "CachedOpenHolidays", "Infrastructure decorator", "A country's year kept 24 h, 5 s timeout, breaker")
  Component(client, "OpenHolidaysCalendar", "Infrastructure", "Calls the OpenHolidays API")
  ComponentDb(db, "Mondino database", "EF Core, PostgreSQL", "Teams, teammates and their cities")
}
System_Ext(source, "OpenHolidays API", "Public holidays")

Rel(ctrl, handler, "Sends GetMomentsQuery")
Rel(handler, db, "Reads the team", "IAppDbContext")
Rel(handler, finder, "Asks for the moments of each city")
Rel(finder, holidays, "Reads IHolidayCalendar")
Rel(finder, own, "Reads IRaceCalendar, IEventCalendar")
Rel(holidays, own, "Reads its holidays")
Rel(holidays, cache, "Reads the public holidays")
Rel(finder, emblems, "Asks for an emblem key")
Rel(cache, client, "Calls on a cache miss")
Rel(client, source, "Asks with a country and a year", "HTTPS")
@enduml
