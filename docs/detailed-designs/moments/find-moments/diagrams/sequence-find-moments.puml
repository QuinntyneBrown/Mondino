@startuml
title UML sequence behaviour — Find the moments of a team's cities
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Mondino web app" #E0F2FE
  participant "HttpTeamApi" as client
end box
box "Backend — Mondino API" #D1FADF
  participant "TeamsController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "GetMomentsQueryHandler" as handler
  participant "MomentFinder" as finder
  participant "EmblemCatalogue" as emblems
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  participant "HolidayCalendar" as holidays
  participant "MondinoCalendar" as own
  participant "CachedOpenHolidays" as cache
  database "Mondino database" as db
end box
participant "OpenHolidays API" as source

client -> controller : GET /api/teams/{teamId}/moments
controller -> handler : Send GetMomentsQuery
handler -> db : Load the team's teammates and their cities
db --> handler : Teammates and their cities
loop each distinct city, in parallel
  handler -> finder : FindForAsync(city)
  finder -> finder : Today in the city's time zone (TimeProvider),\nwindow of today to 90 days ahead
  finder -> holidays : HolidaysInAsync(country, window)
  holidays -> own : Mondino's own holidays of the country
  own --> holidays : Entries
  holidays -> cache : Public holidays of the country, by year
  alt year kept
    cache --> holidays : Kept entries
  else not kept, breaker closed
    cache -> source : PublicHolidays and Subdivisions of a country and year
    alt answers in 5 s
      source --> cache : Holidays and subdivision names
      cache --> holidays : Entries
    else timeout, failure or open breaker
      cache --> holidays : No entries
    end
  end
  holidays --> finder : Own entries, then public ones on other dates
  finder -> own : RaceCalendarInAsync(country, window)
  own --> finder : Race weekends and dated happenings
  finder -> own : EventsNearAsync(city position, 100 km, window)
  own --> finder : Events and fixtures
  finder -> finder : Keep entries in the window that belong\nto the city (L2-020 table); a calendar\nthat throws gives none
  finder -> emblems : KeyFor(subject)
  emblems --> finder : None (ADR 0019)
  finder -> finder : Create each Moment, title cut to 80\nand detail to 160 characters (L2-020)
  finder --> handler : Moments of the city
end
handler -> handler : One MomentDto per teammate a moment\nbelongs to, naming the teammate (L2-020)
handler --> controller : MomentDto list in date order
controller --> client : 200 with the moments, or ProblemDetails
@enduml
