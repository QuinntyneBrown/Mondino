@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Keep the team fresh

class TeamShell <<mondino team/>> {
  provides CLOCK, TeamStore, SETTINGS_STORE
  #bannerText: Signal<string | null>
}

class Banner <<components, mo-banner>> {
  +text: string
  +time: string
  +busy: boolean
  +retry: Output<void>
}

class TeamStore <<mondino team/>> {
  +team: Signal<TeamPins | null>
  +state: Signal<TeamState>
  +moments: Signal<Moment[]>
  +selectedId: Signal<string | null>
  +heldIds: Signal<string[]>
  +arrivedIds: Signal<string[]>
  +refreshFailed: Signal<boolean>
  +refreshing: Signal<boolean>
  +refreshedAt: Signal<number | null>
  -releasing: AbortController
  +load(): Promise<void>
  +refresh(): Promise<void>
  -refreshIfDue(minute: number): void
}

enum TeamState {
  Loading
  Ready
  Failed
  Forgotten
}

interface SettingsStore <<api, SETTINGS_STORE>> {
  +replace(settings: Settings): void
}

interface Clock <<api, CLOCK>> {
  +now(): number
  +minute: Signal<number>
}

class BrowserClock <<domain time/>> {
  +now(): number
  +minute: Signal<number>
}

interface TeamApi <<api, TEAM_API>> {
  +getPins(teamId: string, signal: AbortSignal): Promise<TeamPins>
  +getMoments(teamId: string, signal: AbortSignal): Promise<Moment[]>
}

class HttpTeamApi <<api>>

class TeamPins <<api>> {
  +teamId: string
  +teamName: string
  +inviteToken: string
  +viewerTeammateId: string
  +pins: Pin[]
  +viewerSettings?: Settings
}

class TeamsController <<Mondino.Api>> {
  +GetPins(teamId: Guid): Task<ActionResult<TeamPinsDto>>
}

class GetPinsQuery <<Mondino.Application>> {
  +Guid TeamId
}

class GetPinsQueryHandler <<Mondino.Application>> {
  +Handle(query: GetPinsQuery): Task<TeamPinsDto>
}

class TeamPinsDto <<Mondino.Application>> {
  +Guid TeamId
  +string TeamName
  +string InviteToken
  +Guid ViewerTeammateId
  +IReadOnlyList<PinDto> Pins
  +SettingsDto ViewerSettings
}

interface ICurrentTeammate <<Mondino.Application>>
interface IAppDbContext <<Mondino.Application>>
interface IWeatherSource <<Mondino.Application>>
class MomentFinder <<Mondino.Application>>

Clock <|.. BrowserClock
TeamApi <|.. HttpTeamApi
TeamStore ..> Clock : injects CLOCK
TeamStore ..> TeamApi : injects TEAM_API
TeamStore --> TeamState
TeamStore ..> SettingsStore : replace(viewerSettings)
TeamShell *-- TeamStore
TeamShell ..> Banner : while refreshFailed
TeamStore ..> TeamPins : merges
HttpTeamApi ..> TeamsController : GET /api/teams/{teamId}/pins
TeamsController ..> GetPinsQuery : sends
GetPinsQueryHandler ..> GetPinsQuery : handles
GetPinsQueryHandler ..> TeamPinsDto : builds
GetPinsQueryHandler ..> ICurrentTeammate
GetPinsQueryHandler ..> IAppDbContext
GetPinsQueryHandler ..> IWeatherSource
GetPinsQueryHandler ..> MomentFinder
@enduml
