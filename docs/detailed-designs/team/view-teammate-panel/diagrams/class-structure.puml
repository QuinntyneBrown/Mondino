@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View a teammate's panel

class GlobePage <<mondino>> {
  +teammate: InputSignal<string | undefined>
  -openedFromKeyboard: boolean
  +panel: Signal<TeammatePanelContent | null>
  +groupTeammateIds: WritableSignal<string[]>
  +group: Signal<GroupContent | null>
  +onSelect(teammateId: string): void
  +onSelectGroup(teammateIds: string[]): void
  +onClosed(): void
  +onEscape(): void
}

class TeamStore <<domain pins/>> {
  +pins: Signal<Pin[]>
  +viewerTeammateId: Signal<string | null>
  +selectedTeammateId: Signal<string | null>
  +selectedPin: Signal<Pin | null>
  +viewerPin: Signal<Pin | null>
  +select(teammateId: string): boolean
  +clearSelection(): void
}

class "teammatePanelView" as view <<function, domain pins/>> {
  +teammatePanelView(pin: Pin, viewer: Pin, now: Date, settings: Settings): TeammatePanelContent
  +groupCities(pins: Pin[], teammateIds: string[], now: Date, settings: Settings): GroupContent
  +firstName(name: string): string
}

class TeammatePanelContent <<domain pins/>> {
  +teammateId: string
  +name: string
  +firstName: string
  +initials: string
  +colour: string
  +isViewer: boolean
  +city: string
  +country: string
  +localTime: string
  +localDay: string
  +offset: string | null
  +status: Status | null
  +weather: Weather | null
  +weatherState: WeatherState
  +keepsPrivate: boolean
  +moments: Moment[]
  +overlap: Overlap | null
  +theirDay: DaySpan | null
  +overlapText: OverlapText | null
  +nowMinute: number
}

class Overlap <<domain time/>> {
  +startMinute: number
  +endMinute: number
  +lengthMinutes: number
}

class DaySpan <<domain time/>> {
  +startMinute: number
  +endMinute: number
}

class OverlapText <<domain time/>> {
  +figure: string
  +sentence: string
}

class GroupContent <<domain pins/>> {
  +count: number
  +lead: string
  +cities: GroupCity[]
}

class GroupCity <<domain pins/>> {
  +city: string
  +localTime: string
  +rows: GroupRow[]
}

class GroupRow <<domain pins/>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +isViewer: boolean
}

class GroupPanel <<components, mo-group-panel>> {
  +content: InputSignal<GroupContent>
  +teammateChosen: OutputEmitterRef<string>
  +closed: OutputEmitterRef<void>
  +focusHeading(): void
}

class TeammatePanel <<components, mo-teammate-panel>> {
  +content: InputSignal<TeammatePanelContent>
  +closed: OutputEmitterRef<void>
  +focusHeading(): void
}

class OverlapBar <<components, mo-overlap-bar>> {
  +overlap: InputSignal<Overlap | null>
  +theirDay: InputSignal<DaySpan>
  +nowMinute: InputSignal<number>
  +firstName: InputSignal<string>
  +text: InputSignal<OverlapText>
}

class GlobeView <<globe, mo-globe>> {
  +pins: InputSignal<Pin[]>
  +selectedId: InputSignal<string | null>
  +selectedGroupIds: InputSignal<string[]>
  +select: OutputEmitterRef<string>
  +selectGroup: OutputEmitterRef<string[]>
  +focusPin(teammateId: string): void
}

class Pin <<api>> {
  +teammateId: string
  +name: string
  +colour: string
  +city: string
  +country: string
  +position: Position
  +timeZoneId: string
  +weather: Weather | null
  +weatherState: WeatherState
  +sharesStatus: boolean
  +moments: Moment[]
}

interface Clock <<api, CLOCK>> {
  +now(): Date
  +minute: Signal<Date>
}

GlobePage --> TeamStore : sets selection
GlobePage ..> view : calls
GlobePage --> TeammatePanel : renders
GlobePage --> GlobeView : renders
GlobePage ..> Clock : injects CLOCK
view ..> TeammatePanelContent : builds
view ..> Pin : reads
TeammatePanelContent *-- Overlap
TeammatePanelContent *-- DaySpan
TeammatePanelContent *-- OverlapText
GlobePage --> GroupPanel : renders for a group pin
view ..> GroupContent : builds
GroupContent "1" *-- "1..*" GroupCity
GroupCity "1" *-- "1..*" GroupRow
GroupPanel ..> GroupContent : presents
TeammatePanel ..> TeammatePanelContent : presents
TeammatePanel --> OverlapBar : renders
TeamStore "1" o-- "*" Pin
@enduml
