@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View a teammate's panel

class GlobePage <<mondino>> {
  -requestedId: Signal<string | null>  (queryParamMap "teammate")
  -openedFromKeyboard: boolean
  +panel: Signal<TeammatePanelContent | null>
  +group: Signal<GroupContent | null>
  +announcement: Signal<string>
  +select(teammateId: string): void
  +selectGroup(placement: PinPlacement): void
  +close(): void
  +focusPin(teammateId: string): void
}

class TeamStore <<mondino globe/>> {
  +team: Signal<TeamPins | null>
  +selectedId: Signal<string | null>
  +heldIds: Signal<string[]>
  +select(teammateId: string): boolean
  +selectGroup(teammateIds: string[]): void
  +clear(): void
}

class "teammatePanelView" as view <<function, domain pins/>> {
  +teammatePanelView(pin: Pin, viewer: Pin, now: number, format: ClockFormat, unit: TemperatureUnit): TeammatePanelContent
  +groupCities(pins: Pin[], teammateIds: string[], now: number, format: ClockFormat): GroupContent
  +firstName(name: string): string
}

class TeammatePanelContent <<api>> {
  +teammateId: string
  +name: string
  +firstName: string
  +initials: string
  +colour: string
  +isViewer: boolean
  +cityName: string
  +country: string
  +localTime: string
  +localDay: string
  +offset: string | null
  +status: Status | null
  +weather: PanelWeather | null
  +weatherState: WeatherState
  +weatherNote: string | null
  +privateNote: string | null
  +overlap: OverlapView | null
  +moments (journey 19)
}

class OverlapView <<api>> {
  +overlap: Overlap | null
  +theirDay: DaySpan
  +nowMinute: number
  +firstName: string
  +text: OverlapText
}

class Overlap <<api>> {
  +startMinute: number
  +endMinute: number
  +lengthMinutes: number
}

class DaySpan <<api>> {
  +startMinute: number
  +endMinute: number
}

class OverlapText <<api>> {
  +figure: string
  +sentence: string
}

class GroupContent <<api>> {
  +title: string
  +lead: string
  +cities: GroupCity[]
}

class GroupCity <<api>> {
  +cityName: string
  +localTime: string
  +rows: GroupRow[]
}

class GroupRow <<api>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +isViewer: boolean
}

class GroupPanel <<components, mo-group-panel>> {
  +content: InputSignal<GroupContent>
  +address: InputSignal<(teammateId: string) => string>
  +teammateChosen: OutputEmitterRef<string>
  +closed: OutputEmitterRef<void>
}

class TeammatePanel <<components, mo-teammate-panel>> {
  +content: InputSignal<TeammatePanelContent>
  +closed: OutputEmitterRef<void>
}

class OverlapBar <<components, mo-overlap-bar>> {
  +overlap: InputSignal<Overlap | null>
  +theirDay: InputSignal<DaySpan>
  +nowMinute: InputSignal<number>
  +firstName: InputSignal<string>
  +text: InputSignal<OverlapText>
}

class PinLayer <<components, mo-pin-layer>> {
  +placements: InputSignal<PinPlacement[]>
  +selectedId: InputSignal<string | null>
  +selectedGroupKey: InputSignal<string | null>
  +selectPin: OutputEmitterRef<string>
  +selectGroup: OutputEmitterRef<PinPlacement>
}

class GlobeView <<globe, mo-globe>> {
  +facing: InputSignal<Position | null>
}

class Pin <<api>> {
  +teammateId: string
  +name: string
  +colour: string
  +cityName: string
  +country: string
  +position: Position
  +timeZoneId: string
  +weather: Weather | null
  +weatherState: WeatherState
  +sharesStatus: boolean
  +isViewer: boolean
}

interface Clock <<api, CLOCK>> {
  +now(): number
  +minute: Signal<number>
}

GlobePage --> TeamStore : sets selection
GlobePage ..> view : calls
GlobePage --> TeammatePanel : renders
GlobePage --> GlobeView : renders, facing
GlobePage --> PinLayer : renders, selection
GlobePage ..> Clock : injects CLOCK
view ..> TeammatePanelContent : builds
view ..> Pin : reads
TeammatePanelContent *-- OverlapView
OverlapView *-- Overlap
OverlapView *-- DaySpan
OverlapView *-- OverlapText
GlobePage --> GroupPanel : renders for a group pin
view ..> GroupContent : builds
GroupContent "1" *-- "1..*" GroupCity
GroupCity "1" *-- "1..*" GroupRow
GroupPanel ..> GroupContent : presents
TeammatePanel ..> TeammatePanelContent : presents
TeammatePanel --> OverlapBar : renders
TeamStore "1" o-- "*" Pin
@enduml
