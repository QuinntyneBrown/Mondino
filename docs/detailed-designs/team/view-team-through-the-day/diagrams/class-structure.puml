@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the team through the day

class TeamPage <<mondino>> {
  {static} +LargeTeamThreshold: number = 40
  +filter: InputSignal<string | undefined>
  +statusFilter: Signal<StatusFilter>
  +query: WritableSignal<string>
  +toggled: WritableSignal<Map<string, boolean>>
  +large: Signal<boolean>
  +rows: Signal<TeamRow[]>
  +visibleRows: Signal<TeamRow[]>
  +sections: Signal<CitySectionContent[]>
  +markers: Signal<RibbonMarker[]>
  +density: Signal<RibbonDensity | null>
  +options: Signal<Option[]>
  +onFilter(filter: StatusFilter): void
  +onSearch(text: string): void
  +onToggle(cityKey: string): void
  +onShowEveryone(): void
  +onInvite(): void
  +onTeammateChosen(teammateId: string): void
}

class TeamStore <<domain pins/>> {
  +pins: Signal<Pin[]>
  +viewerPin: Signal<Pin | null>
  +counts: Signal<TeamCounts>
}

class "pins/ functions" as fn <<function, domain pins/>> {
  +orderWestToEast(pins: Pin[], now: Date): Pin[]
  +teamRows(pins: Pin[], viewer: Pin, now: Date, settings: Settings): TeamRow[]
  {static} +CityRowLimit: number = 50
  +filterByStatus(rows: TeamRow[], filter: StatusFilter): TeamRow[]
  +searchRows(rows: TeamRow[], query: string): TeamRow[]
  +citySections(rows: TeamRow[], toggled: Map<string, boolean>, now: Date, settings: Settings): CitySectionContent[]
  +ribbonMarkers(pins: Pin[], now: Date, settings: Settings): RibbonMarker[]
  +ribbonDensity(pins: Pin[], now: Date, settings: Settings): RibbonDensity
}

class "zoneOffsetMinutes" as off <<function, domain time/>> {
  +zoneOffsetMinutes(now: Date, timeZoneId: string): number
}

enum StatusFilter {
  All
  Working
  Asleep
}

class TeamRow <<domain pins/>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +isViewer: boolean
  +city: string
  +country: string
  +localTime: string
  +offset: string | null
  +status: Status | null
  +weather: Weather | null
  +weatherState: WeatherState
  +nextMoment: Moment | null
  +nextMomentWhen: string | null
}

class RibbonMarker <<domain pins/>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +localTime: string
  +dayFraction: number
  +lane: number
}

class CitySectionContent <<domain pins/>> {
  +key: string
  +name: string
  +count: number
  +localTime: string
  +open: boolean
  +rows: TeamRow[]
  +more: number
}

class RibbonDensity <<domain pins/>> {
  +bins: number[]
  +max: number
  +maxBin: number
  +maxBinTime: string
}

class Option <<components>> {
  +value: string
  +label: string
  +count: number | null
}

class DayRibbon <<components, mo-day-ribbon>> {
  +markers: InputSignal<RibbonMarker[]>
  +density: InputSignal<RibbonDensity | null>
  +summary: InputSignal<string | null>
  +teammateChosen: OutputEmitterRef<string>
}

class Segmented <<components, mo-segmented>> {
  +options: InputSignal<Option[]>
  +value: InputSignal<string>
  +mode: InputSignal<'tabs' | 'radio'>
  +valueChange: OutputEmitterRef<string>
}

class TeamTable <<components, mo-team-table>> {
  +rows: InputSignal<TeamRow[]>
  +caption: InputSignal<string>
  +teammateChosen: OutputEmitterRef<string>
}

class SearchField <<components, mo-search-field>> {
  +value: InputSignal<string>
  +label: InputSignal<string>
  +valueChange: OutputEmitterRef<string>
}

class CitySection <<components, mo-city-section>> {
  +content: InputSignal<CitySectionContent>
  +toggle: OutputEmitterRef<string>
  +teammateChosen: OutputEmitterRef<string>
}

class ListNote <<components, mo-list-note>> {
  +title: InputSignal<string>
  +text: InputSignal<string>
  +action: InputSignal<string | null>
  +actionChosen: OutputEmitterRef<void>
}

class InvitePrompt <<components, mo-invite-prompt>> {
  +teamName: InputSignal<string>
  +invite: OutputEmitterRef<void>
}

TeamPage --> TeamStore : reads
TeamPage ..> fn : calls
TeamPage --> StatusFilter : holds
TeamPage --> DayRibbon : renders
TeamPage --> Segmented : renders
TeamPage --> TeamTable : renders for 40 or fewer
TeamPage --> SearchField : renders for a large team
TeamPage --> CitySection : renders one for each city
TeamPage --> ListNote : renders when no row is left
TeamPage --> InvitePrompt : renders for a team of one
CitySection --> TeamTable : renders its rows
CitySection ..> CitySectionContent : presents
CitySectionContent "1" o-- "0..50" TeamRow
fn ..> CitySectionContent : builds
fn ..> RibbonDensity : builds
DayRibbon ..> RibbonDensity : presents as 48 bars
fn ..> off : orders by
fn ..> TeamRow : builds
fn ..> RibbonMarker : builds
DayRibbon ..> RibbonMarker : presents
Segmented ..> Option : presents
TeamTable ..> TeamRow : presents
@enduml
