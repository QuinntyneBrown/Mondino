@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the team through the day

Person(teammate, "Teammate", "The viewer")
Container_Boundary(web, "Mondino web app") {
  Component(page, "TeamPage", "Angular page, mondino application", "Orders, filters, searches and presents the team; navigates to the Globe screen")
  Component(store, "TeamStore", "Signal store, mondino application, provided by TeamShell", "Holds the team's pins, read once for the teammate screens")
  Component(rows, "teamRows, teamCounts, filterByStatus, ribbonMarkers; searchRows, citySections and ribbonDensity", "Pure functions, domain pins/", "West-to-east rows, counts, status filter, ribbon positions; search, city sections and half-hour counts for a large team")
  Component(time, "time/ rules", "Pure functions, domain time/", "localTime, statusFor, offsetBetween, zoneOffsetMinutes")
  Component(clock, "BrowserClock", "Clock, domain time/, provided by TeamPage", "The screen's one clock and its minute tick")
  Component(ribbon, "DayRibbon", "Angular component, components library", "Places each teammate on the 24 hours of a day; a bar chart of 48 half hours for a large team")
  Component(chips, "Segmented", "Angular component, components library", "All, Working now, Asleep, as tabs with counts")
  Component(table, "TeamTable", "Angular component, components library", "Rows of a small team or of one city; a table from 768 px, a list below")
  Component(search, "SearchField", "Angular component, components library", "Find a person or city, for a large team")
  Component(city, "CitySection", "Angular component, components library", "One city of a large team: a button with count and local time, and at most 50 rows")
  Component(note, "ListNote", "Angular component, components library", "Says that nothing matches, with Show everyone")
  Component(prompt, "InvitePrompt", "Angular component, components library", "For a team of one: Invite teammates")
  Component(empty, "EmptyState", "Angular component, components library", "The team didn't load, with Try again")
}
Rel(teammate, ribbon, "Chooses a marker on")
Rel(teammate, chips, "Chooses a filter in")
Rel(teammate, table, "Chooses a row in")
Rel(teammate, search, "Types a name or a city in")
Rel(teammate, city, "Opens and closes")
Rel(page, store, "Reads the pins from; reads them again on Try again")
Rel(page, rows, "Reads rows and markers from")
Rel(rows, time, "Works out local time, status and offset with")
Rel(page, clock, "Reads the minute tick of")
Rel(page, ribbon, "Passes RibbonMarker values or a RibbonDensity to")
Rel(page, chips, "Passes the filters and counts to")
Rel(page, table, "Passes TeamRow values to")
Rel(page, search, "Reads the search text from")
Rel(page, city, "Passes a CitySectionContent to")
Rel(city, table, "Renders its rows with")
Rel(page, note, "Shows when no row is left")
Rel(page, prompt, "Shows for a team of one; opens the invite dialog on invite")
Rel(page, empty, "Shows when the first read fails")
@enduml
