@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the week around the world

Person(teammate, "Teammate", "The viewer")
Container_Boundary(web, "Mondino web app") {
  Component(page, "GlobePage", "Angular page, mondino application", "Chooses between the week panel and the invite card; heads the globe with the counts")
  Component(store, "TeamStore", "Signal store, domain pins/", "Holds the pins, the counts, the team's invite token and the selection")
  Component(week, "weekMoments and workingNow", "Pure functions, domain moments/ and pins/", "At most six moments of the next 7 days and six teammates in working hours, with their count")
  Component(counts, "teamCounts", "Pure function, domain pins/", "Teammates, time zones, working and asleep")
  Component(clock, "BrowserClock", "Clock, domain time/", "The one shared clock and its minute tick")
  Component(panel, "WeekPanel", "Angular component, components library", "Lists the week's moments and who is in working hours now, six of each at most")
  Component(card, "InviteCard", "Angular component, components library", "Shows the invite link with a Copy button")
  Component(shell, "TeamShell", "Route component, mondino application", "Holds the four screens; renders the header and the toast; opens the invite dialog")
  Component(header, "AppHeader", "Angular component, components library", "The header; its Invite teammate button emits invite")
  Component(copier, "InviteLinkCopier", "Service, mondino application", "Copies the team's invite link and holds the result")
  Component(toast, "Toast", "Angular component, components library", "Says the invite link was copied, or could not be; says a person has just joined")
  Component(clip, "Clipboard", "Angular CDK service", "Writes text to the clipboard")
}
Rel(teammate, panel, "Chooses a moment or a teammate in")
Rel(teammate, card, "Uses Copy on")
Rel(page, store, "Reads pins, counts and invite token from; selects in")
Rel(page, week, "Reads the panel's lists from")
Rel(store, counts, "Derives counts with")
Rel(week, clock, "Reads the minute tick of")
Rel(counts, clock, "Reads the minute tick of")
Rel(page, panel, "Passes moments and teammates to")
Rel(page, card, "Passes the invite link to")
Rel(teammate, header, "Uses Invite teammate in")
Rel(shell, header, "Renders; hears invite from")
Rel(page, copier, "Copies the invite link with")
Rel(shell, copier, "Reads the result from")
Rel(copier, store, "Reads the invite token from")
Rel(copier, clip, "Writes the link with")
Rel(shell, toast, "Confirms the copy with")
@enduml
