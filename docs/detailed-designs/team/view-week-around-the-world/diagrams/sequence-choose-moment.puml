@startuml
title UML sequence behaviour — Show the week panel and choose a moment in it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobePage" as page
  participant "TeamStore" as store
  participant "teamCounts / workingNow" as fn
  participant "WeekPanel" as panel
  participant "Router" as router
  participant "GlobeView" as globe
end box
actor -> page : Open the Globe screen with no pin selected
page -> store : team
store --> page : Pin[]
page -> fn : teamCounts(pins, clock.now())
fn --> page : TeamCounts
page --> actor : "13 teammates" and "12 time zones · 8 working · 2 asleep" (L2-025)
page -> fn : workingNow(pins, clock.now(), format, 6)
fn -> fn : Keep status Working hours, order by local hour, then west to east (L2-024)
fn --> page : WorkingNow (count 8, first 6, 2 more)
page -> panel : working
panel --> actor : "This week around the world": "No moments this week." until journey 19\nbrings at most six moments, then "All moments"
alt no teammate in working hours
  panel --> actor : "Nobody — it’s quiet everywhere."
else
  panel --> actor : "In working hours now", its count, at most six teammates,\nthen "2 more on the Team page" (L2-024)
end
actor -> panel : Choose a teammate in working hours (or, with journey 19, a moment)
panel -> page : teammateChosen(teammateId)
page -> router : navigate /globe?teammate={teammateId}
router --> page : the teammate query parameter changes
page -> store : select(teammateId)
page -> globe : selectedId; the globe turns to the pin (L2-024)
page --> actor : That teammate's panel (L2-023)
opt the teammate wants every moment
  actor -> panel : Choose "All moments"
  panel -> page : allMoments
  page -> router : navigate /moments
end
opt the teammate wants everyone in working hours
  actor -> panel : Choose "2 more on the Team page"
  panel -> page : moreWorking
  page -> router : navigate /team?filter=working
end
@enduml
