@startuml
title UML sequence behaviour — Show the week panel and choose a moment in it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobePage" as page
  participant "TeamStore" as store
  participant "weekMoments / workingNow" as fn
  participant "WeekPanel" as panel
  participant "Router" as router
  participant "GlobeView" as globe
end box
actor -> page : Open the Globe screen with no pin selected
page -> store : pins, counts
store --> page : Pin[], TeamCounts
page --> actor : "12 teammates" and "11 time zones · 4 working · 3 asleep" (L2-025)
page -> fn : weekMoments(pins, clock.now(), 8)
fn -> fn : Keep moments from today to 7 days ahead in each city, in date order (L2-024)
fn --> page : WeekMoments (first 8, more flag)
page -> fn : workingNow(pins, clock.now())
fn -> fn : Keep status Working hours, order by local hour (L2-024)
fn --> page : WorkingTeammate[]
page -> panel : moments, moreMoments, working
alt no teammate in working hours
  panel --> actor : "Nobody — it's quiet everywhere."
else
  panel --> actor : "This week around the world" and "In working hours now"
end
actor -> panel : Choose a moment
panel -> page : momentChosen(teammateId)
page -> router : navigate /globe?teammate={teammateId}
router --> page : teammate input changes
page -> store : select(teammateId)
page -> globe : selectedId; the globe turns to the pin (L2-024)
page --> actor : That teammate's panel (L2-023)
opt more than 8 moments this week
  actor -> panel : Choose "All moments"
  panel -> page : allMoments
  page -> router : navigate /moments
end
@enduml
