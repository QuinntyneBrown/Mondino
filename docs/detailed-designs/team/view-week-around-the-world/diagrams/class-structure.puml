@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the week around the world

class GlobePage <<mondino>> {
  +week: Signal<WeekMoment[]>
  +working: Signal<WorkingTeammate[]>
  +teamOfOne: Signal<boolean>
  +inviteLink: Signal<string | null>
  +copyResult: WritableSignal<CopyResult | null>
  +onTeammateChosen(teammateId: string): void
  +onAllMoments(): void
  +onCopy(): void
}

class TeamStore <<domain pins/>> {
  +pins: Signal<Pin[]>
  +viewerTeammateId: Signal<string | null>
  +inviteToken: Signal<string | null>
  +counts: Signal<TeamCounts>
  +select(teammateId: string): boolean
}

class TeamCounts <<domain pins/>> {
  +teammates: number
  +timeZones: number
  +working: number
  +asleep: number
}

class "moments/ and pins/ functions" as fn <<function, domain>> {
  +weekMoments(pins: Pin[], now: Date, limit: number): WeekMoments
  +workingNow(pins: Pin[], now: Date): WorkingTeammate[]
  +teamCounts(pins: Pin[], now: Date): TeamCounts
  +inviteLinkFor(origin: string, inviteToken: string): string
}

class WeekMoments <<domain moments/>> {
  +moments: WeekMoment[]
  +more: boolean
}

class WeekMoment <<domain moments/>> {
  +teammateId: string
  +teammateName: string
  +city: string
  +kind: MomentKind
  +title: string
  +when: string
  +emblemKey: string | null
}

class WorkingTeammate <<domain pins/>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +city: string
  +localTime: string
}

class WeekPanel <<components, mo-week-panel>> {
  +moments: InputSignal<WeekMoment[]>
  +working: InputSignal<WorkingTeammate[]>
  +teammateChosen: OutputEmitterRef<string>
  +allMoments: OutputEmitterRef<void>
}

class InviteCard <<components, mo-invite-card>> {
  +inviteLink: InputSignal<string>
  +copy: OutputEmitterRef<void>
}

enum CopyResult {
  Copied
  Refused
}

class Toast <<components, mo-toast>> {
  +title: InputSignal<string>
  +text: InputSignal<string>
  +tone: InputSignal<'success' | 'danger'>
  +dismissed: OutputEmitterRef<void>
}

class Clipboard <<Angular CDK>> {
  +copy(text: string): boolean
}

GlobePage --> TeamStore : reads / selects
GlobePage ..> fn : calls
GlobePage --> WeekPanel : renders
GlobePage --> InviteCard : renders for a team of one
GlobePage ..> Clipboard : injects
GlobePage --> Toast : renders after Copy
TeamStore *-- TeamCounts
fn ..> WeekMoments : builds
fn ..> WorkingTeammate : builds
fn ..> TeamCounts : builds
WeekMoments "1" *-- "0..8" WeekMoment
WeekPanel ..> WeekMoment : presents
WeekPanel ..> WorkingTeammate : presents
@enduml
