@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the week around the world

class GlobePage <<mondino>> {
  +week: Signal<WeekMoment[]>
  +working: Signal<WorkingNow>
  +momentsOff: Signal<boolean>
  +teamOfOne: Signal<boolean>
  +inviteLink: Signal<string | null>
  +onTeammateChosen(teammateId: string): void
  +onAllMoments(): void
  +onMoreWorking(): void
  +onChooseMoments(): void
  +onCopy(): void
}

class TeamStore <<domain pins/>> {
  +pins: Signal<Pin[]>
  +viewerTeammateId: Signal<string | null>
  +inviteToken: Signal<string | null>
  +counts: Signal<TeamCounts>
  +select(teammateId: string): boolean
}

class TeamCounts <<domain pins/>> {
  +teammates: number
  +timeZones: number
  +working: number
  +asleep: number
}

class "moments/ and pins/ functions" as fn <<function, domain>> {
  +weekMoments(pins: Pin[], now: Date, limit: number): WeekMoments
  +workingNow(pins: Pin[], now: Date, limit: number): WorkingNow
  +teamCounts(pins: Pin[], now: Date): TeamCounts
  +inviteLinkFor(origin: string, inviteToken: string): string
}

class WeekMoments <<domain moments/>> {
  +moments: WeekMoment[]
  +more: boolean
}

class WeekMoment <<domain moments/>> {
  +teammateId: string
  +teammateFirstName: string
  +city: string
  +kind: MomentKind
  +title: string
  +when: string
  +emblemKey: string | null
}

class WorkingNow <<domain pins/>> {
  +count: number
  +teammates: WorkingTeammate[]
  +more: number
}

class WorkingTeammate <<domain pins/>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +city: string
  +localTime: string
}

class WeekPanel <<components, mo-week-panel>> {
  +moments: InputSignal<WeekMoment[]>
  +working: InputSignal<WorkingNow>
  +momentsOff: InputSignal<boolean>
  +teammateChosen: OutputEmitterRef<string>
  +allMoments: OutputEmitterRef<void>
  +moreWorking: OutputEmitterRef<void>
  +chooseMoments: OutputEmitterRef<void>
}

class InviteCard <<components, mo-invite-card>> {
  +inviteLink: InputSignal<string>
  +copy: OutputEmitterRef<void>
  +selectLink(): void
}

enum CopyResult {
  Copied
  Refused
}

class Toast <<components, mo-toast>> {
  +title: InputSignal<string | null>
  +text: InputSignal<string>
  +tone: InputSignal<'success' | 'danger'>
  +dismissed: OutputEmitterRef<void>
}

class AppHeader <<components, mo-app-header>> {
  +invite: OutputEmitterRef<void>
}

class TeamShell <<mondino>> {
  +onInvite(): void
}

class InviteLinkCopier <<mondino>> {
  +result: Signal<CopyResult | null>
  +copy(): void
  +dismiss(): void
}

class Clipboard <<Angular CDK>> {
  +copy(text: string): boolean
}

GlobePage --> TeamStore : reads / selects
GlobePage ..> fn : calls
GlobePage --> WeekPanel : renders
GlobePage --> InviteCard : renders for a team of one
GlobePage ..> InviteLinkCopier : copies on Copy
TeamShell --> AppHeader : renders
TeamShell ..> InviteLinkCopier : reads the result
TeamShell --> Toast : renders from the result
InviteLinkCopier ..> TeamStore : reads inviteToken
InviteLinkCopier ..> Clipboard : injects
InviteLinkCopier --> CopyResult
TeamStore *-- TeamCounts
fn ..> WeekMoments : builds
fn ..> WorkingNow : builds
WorkingNow "1" *-- "0..6" WorkingTeammate
fn ..> TeamCounts : builds
WeekMoments "1" *-- "0..6" WeekMoment
WeekPanel ..> WeekMoment : presents
WeekPanel ..> WorkingNow : presents
@enduml
