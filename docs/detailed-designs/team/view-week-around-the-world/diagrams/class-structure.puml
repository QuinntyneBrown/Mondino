@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the week around the world

class GlobePage <<mondino>> {
  +counts: Signal<TeamCounts | null>
  +working: Signal<WorkingNow | null>
  +teamOfOne: Signal<boolean>
  +inviteLink: Signal<string>
  #select(teammateId: string): void
  #go(address: string): void
  #copy(): Promise<void>
}

class TeamStore <<mondino>> {
  +team: Signal<TeamPins | null>
  +state: Signal<TeamState>
  +selectedId: Signal<string | null>
  +load(): Promise<void>
  +select(teammateId: string): void
  +clear(): void
}

class TeamCounts <<api>> {
  +teammates: number
  +timeZones: number
  +working: number
  +asleep: number
}

class "pins/ functions" as fn <<function, domain>> {
  +teamCounts(pins: Pin[], now: number): TeamCounts
  +orderWestToEast(pins: Pin[], now: number): Pin[]
  +workingNow(pins: Pin[], now: number, format: ClockFormat, limit: number): WorkingNow
  +inviteLinkFor(origin: string, inviteToken: string): string
}

class WorkingNow <<api>> {
  +count: number
  +teammates: WorkingTeammate[]
  +more: number
}

class WorkingTeammate <<api>> {
  +teammateId: string
  +name: string
  +initials: string
  +colour: string
  +cityName: string
  +localTime: string
  +isViewer: boolean
}

class WeekPanel <<components, mo-week-panel>> {
  +working: InputSignal<WorkingNow>
  +address: InputSignal<(teammateId: string) => string>
  +allMomentsAddress: InputSignal<string>
  +moreWorkingAddress: InputSignal<string>
  +teammateChosen: OutputEmitterRef<string>
  +allMoments: OutputEmitterRef<void>
  +moreWorking: OutputEmitterRef<void>
}

class InviteCard <<components, mo-invite-card>> {
  +inviteLink: InputSignal<string>
  +copyLink: OutputEmitterRef<void>
  +selectLink(): void
}

class Toast <<components, mo-toast>> {
  +strong: InputSignal<string | null>
  +text: InputSignal<string>
  +tone: InputSignal<'success' | 'danger'>
  +dismiss: OutputEmitterRef<void>
}

class AppHeader <<components, mo-app-header>> {
  +homeAddress: InputSignal<string>
  +home: OutputEmitterRef<void>
  +invite: OutputEmitterRef<HTMLElement>
}

class TeamShell <<mondino>> {
  #viewer: Signal<Pin | null>
  #invite(trigger: HTMLElement): void
}

class Toaster <<mondino>> {
  +current: Signal<ToastMessage | null>
  +show(toast: ToastMessage): void
  +dismiss(): void
}

class InviteLinkCopier <<mondino>> {
  +copy(): Promise<boolean>
}

interface Clipboard <<api, CLIPBOARD>> {
  +write(text: string): Promise<void>
}

GlobePage --> TeamStore : reads / selects
GlobePage ..> fn : calls
GlobePage --> WeekPanel : renders
GlobePage --> InviteCard : renders for a team of one
GlobePage ..> InviteLinkCopier : copies on Copy
GlobePage ..> Toaster : greets a teammate who has just joined
TeamShell --> TeamStore : provides, loads
TeamShell --> AppHeader : renders
TeamShell --> Toast : renders from Toaster
TeamShell ..> Toaster : reads
InviteLinkCopier ..> TeamStore : reads inviteToken
InviteLinkCopier ..> Clipboard : writes with
InviteLinkCopier ..> Toaster : shows the result with
fn ..> TeamCounts : builds
fn ..> WorkingNow : builds
WorkingNow "1" *-- "0..6" WorkingTeammate
WeekPanel ..> WorkingNow : presents
@enduml
