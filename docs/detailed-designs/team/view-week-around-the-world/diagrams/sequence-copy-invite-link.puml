@startuml
title UML sequence behaviour — A team of one copies the invite link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobePage" as page
  participant "TeamStore" as store
  participant "inviteLinkFor" as fn
  participant "InviteCard" as card
  participant "AppHeader" as header
  participant "TeamShell" as shell
  participant "InviteLinkCopier" as copier
  participant "Clipboard" as clip
  participant "Toast" as toast
end box
actor -> page : Open the Globe screen
page -> store : pins, viewerTeammateId, inviteToken
store --> page : One pin, the viewer's own
page -> page : teamOfOne is true (L2-025)
page -> fn : inviteLinkFor(origin, inviteToken)
fn --> page : origin + /join/{inviteToken}
page -> card : inviteLink
page --> actor : "Just you, for now", "Invite your team to fill the map", the invite link and "Copy"; no panel
alt "Copy" on the invite card
  actor -> card : Use "Copy"
  card -> page : copy
  page -> copier : copy()
else "Invite teammate" in the header, on any of the four screens
  actor -> header : Use "Invite teammate"
  header -> shell : invite
  shell -> copier : copy()
end
copier -> clip : copy(inviteLink)
alt the link is on the clipboard
  clip --> copier : true
  copier --> shell : result is Copied
  shell -> toast : "Invite link copied", status region, 4 seconds
  toast --> actor : Confirmation announced to assistive technology (L2-025)
else the browser refuses
  clip --> copier : false
  copier --> shell : result is Refused
  shell -> toast : "Couldn't copy the invite link", alert, until dismissed
  toast --> actor : The failure announced; the link stays shown as selectable text (L2-025)
end
== A second teammate joins ==
store -> store : Next load or refresh brings two pins (L2-048)
store --> page : pins, counts
page -> page : teamOfOne is false
page --> actor : "2 teammates"; WeekPanel in place of InviteCard
@enduml
