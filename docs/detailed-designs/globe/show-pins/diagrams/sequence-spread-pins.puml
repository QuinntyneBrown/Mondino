@startuml
title UML sequence behaviour — Fan and group pins that are close together
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobeView" as view
  participant "spreadPins (PIN_SPREADER)" as spread
  participant "PinLayer" as layer
  participant "LabelPlacer" as labels
  participant "GlobeScene" as scene
  participant "GroupPinMenu" as menu
end box
view -> view : pins input or globe size changed (ResizeObserver)
view -> spread : spread(pins, globeSize)
spread -> spread : Gather pins closer than a pin's width at this size
alt cluster fits in a fan (L2-013 AC1)
  spread -> spread : One placement per pin, offset around the city's position
else more pins than can be fanned (L2-013 AC3)
  spread -> spread : One group placement with its pins and a count
end
spread --> view : PinPlacement[]
view -> layer : placements, compact = globe under 400 px wide (L2-013 AC4)
loop each frame in which the globe has turned
  layer -> scene : project(placement.position)
  scene --> layer : x, y and whether it faces the viewer
  layer -> layer : Move each pin to x + offsetX, y + offsetY;\nhide pins on the far side (L2-011 AC5)
  layer -> labels : place(projected pins, globe area)
  labels --> layer : A side for each shown label, inside the globe\nand clear of other pins (L2-013 AC5)
end
layer --> actor : Every pin visible and selectable on its own
actor -> layer : Select a group pin
layer -> menu : Open with the group's pins
menu --> actor : List of the group's teammates
actor -> menu : Choose a teammate
menu --> layer : choose(teammate id)
layer --> view : select(teammate id)
@enduml
