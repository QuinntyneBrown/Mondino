@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show pins

Person(teammate, "Teammate", "A person on a team")
System_Boundary(mondino, "Mondino") {
  Container(spa, "Mondino web app", "Angular", "Draws a pin for each teammate, lifts it and keeps close pins apart")
  Container(api, "Mondino API", "ASP.NET Core", "Gives the team's pins: city, position, time zone, weather, never a postal code")
  ContainerDb(db, "Mondino database", "EF Core, PostgreSQL", "Teams, teammates and their cities")
}
System_Ext(openmeteo, "Open-Meteo", "Current weather at a place")
Rel(teammate, spa, "Points at, focuses and selects pins", "HTTPS")
Rel(spa, api, "GET /api/teams/{teamId}/pins", "JSON/HTTPS")
Rel(api, db, "Reads the team's teammates", "EF Core")
Rel(api, openmeteo, "Reads cached weather for each city", "HTTPS")
@enduml
