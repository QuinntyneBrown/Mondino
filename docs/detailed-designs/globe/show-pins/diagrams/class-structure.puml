@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show pins
set separator none

package "api library" {
  class Pin {
    +teammateId: string
    +name: string
    +colour: string
    +cityName: string
    +country: string
    +position: Position
    +timeZoneId: string
    +weather: Weather | null
    +weatherState: WeatherState
    +sharesStatus: boolean
    +isViewer: boolean
    +moments: Moment[]
  }
  class PlacePoint {
    +position: Position
    +pins: Pin[]
    +x: number
    +y: number
    +depth: number
  }
  class PinPlacement {
    +kind: 'pin' | 'group'
    +position: Position
    +pins: Pin[]
  }
  class GroupOptions {
    +radiusPx: number
    +selectedId: string | null
    +heldGroupIds: string[]
  }
  interface PinGrouper {
    +group(points: PlacePoint[], options: GroupOptions): PinPlacement[]
  }
}

package "domain library" {
  class "groupPins" as groupPins << (F,#D1FADF) function >> {
    +groupPins(points: PlacePoint[], options: GroupOptions): PinPlacement[]
  }
}

package "globe library" {
  class GlobeView {
    +pins: InputSignal<Pin[]>
    +descriptions: InputSignal<Map<string, string>>
    +selectedId: InputSignal<string | null>
    +selectedGroupIds: InputSignal<string[]>
    +interactive: InputSignal<boolean>
    +select: OutputEmitterRef<string | null>
    +selectGroup: OutputEmitterRef<string[]>
    +globeSize: Signal<number>
  }
  class PinLayer {
    +pins: InputSignal<Pin[]>
    +globeSize: InputSignal<number>
    +descriptions: InputSignal<Map<string, string>>
    +selectedId: InputSignal<string | null>
    +selectedGroupIds: InputSignal<string[]>
    +compact: InputSignal<boolean>
    +select: OutputEmitterRef<string | null>
    +selectGroup: OutputEmitterRef<string[]>
    +liftedId: Signal<string | null>
    +placements: Signal<PinPlacement[]>
    +update(scene: GlobeScene): void
    +anchorOf(teammateIds: string[]): Position | null
  }
  class LabelPlacer {
    {static} +place(points: ProjectedPin[], globe: DOMRect): LabelSide[]
  }
  class PinMarkTemplate << directive moPinMark >>
  class PinLabelTemplate << directive moPinLabel >>
  class GlobeScene {
    +project(position: Position): ProjectedPoint
  }
  class ProjectedPoint {
    +x: number
    +y: number
    +depth: number
    +facing: boolean
  }
}

package "Mondino.Application" {
  class GetPinsQuery {
    +Guid TeamId
  }
  class GetPinsQueryHandler {
    +Handle(query: GetPinsQuery): Task<TeamPinsDto>
  }
  class TeamPinsDto {
    +Guid TeamId
    +string TeamName
    +string InviteToken
    +Guid ViewerTeammateId
    +IReadOnlyList<PinDto> Pins
  }
  class PinDto {
    +Guid TeammateId
    +string Name
    +string Colour
    +string CityName
    +string Country
    +Position Position
    +string TimeZoneId
    +WeatherDto? Weather
    +WeatherState WeatherState
    +bool SharesStatus
    +bool IsViewer
    +IReadOnlyList<MomentDto> Moments
  }
}

groupPins ..|> PinGrouper : bound to PIN_GROUPER
PinGrouper ..> PlacePoint : reads
PinGrouper ..> GroupOptions : reads
PinGrouper ..> PinPlacement : returns
PlacePoint "1" o-- "1..*" Pin
PinPlacement "1" o-- "1..*" Pin
GlobeView *-- PinLayer
PinLayer ..> PinGrouper : injects
GlobeView ..> PinMarkTemplate : content
GlobeView ..> PinLabelTemplate : content
PinLayer ..> LabelPlacer : places labels with
PinLayer ..> GlobeScene : projects with
GlobeScene ..> ProjectedPoint : returns
GetPinsQueryHandler ..> GetPinsQuery : handles
GetPinsQueryHandler ..> TeamPinsDto : returns
TeamPinsDto "1" o-- "*" PinDto
PinDto ..> Pin : serialised as
@enduml
