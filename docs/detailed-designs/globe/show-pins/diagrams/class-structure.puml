@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show pins
set separator none

package "api library" {
  class Pin {
    +teammateId: string
    +name: string
    +colour: string
    +cityName: string
    +country: string
    +position: Position
    +timeZoneId: string
    +weather: Weather | null
    +weatherState: WeatherState
    +sharesStatus: boolean
    +isViewer: boolean
    +moments: Moment[]
  }
  class GlobeViewport {
    +widthPx: number
    +project(position: Position): ProjectedPoint | null
  }
  class PinView {
    +teammateId: string
    +initials: string
    +colour: string
    +name: string
    +cityName: string
    +localTime: string
    +description: string
    +isViewer: boolean
    +isNew: boolean
  }
  class PinPlacement {
    +key: string
    +kind: 'pin' | 'group'
    +x: number
    +y: number
    +depth: number
    +far: boolean
    +pins: PinView[]
    +description: string
    +labelSide: LabelSide | null
  }
}

package "domain library" {
  class "placePins" as placePins << (F,#D1FADF) function >> {
    +placePins(pins: Pin[], views: PinView[], viewport: GlobeViewport, selection): PinPlacement[]
  }
  class "groupPins" as groupPins << (F,#D1FADF) function >> {
    +groupPins(points: PlacePoint[], options: GroupOptions): Group[]
  }
  class "placeLabels" as placeLabels << (F,#D1FADF) function >> {
    +placeLabels(placements, widthPx, compact): PinPlacement[]
  }
  class "pinViews" as pinViews << (F,#D1FADF) function >> {
    +pinViews(pins: Pin[], now: number): PinView[]
  }
  class "stillViewport" as stillViewport << (F,#D1FADF) function >> {
    +stillViewport(widthPx: number): GlobeViewport
  }
}

package "globe library" {
  class GlobeView {
    +interactive: InputSignal<boolean>
    +facing: InputSignal<Position | null>
    +viewChange: OutputEmitterRef<GlobeViewport>
    +blankTap: OutputEmitterRef<void>
  }
  class GlobeScene {
    +project(position: Position): ProjectedPoint | null
  }
}

package "components library" {
  class PinLayer {
    +placements: InputSignal<PinPlacement[]>
    +selectedId: InputSignal<string | null>
    +selectedGroupKey: InputSignal<string | null>
    +compact: InputSignal<boolean>
    +select: OutputEmitterRef<string>
    +selectGroup: OutputEmitterRef<PinPlacement>
    +liftedKey: Signal<string | null>
  }
  class GlobeFallback
}

package "mondino application" {
  class GlobePage
  class TeamStore {
    +pins: Signal<TeamPins | null>
    +selectedId: Signal<string | null>
    +selectedGroup: Signal<PinPlacement | null>
  }
}

package "Mondino.Application" {
  class GetPinsQuery {
    +Guid TeamId
  }
  class GetPinsQueryHandler {
    +Handle(query: GetPinsQuery): Task<TeamPinsDto>
  }
  class TeamPinsDto {
    +Guid TeamId
    +string TeamName
    +string InviteToken
    +Guid ViewerTeammateId
    +IReadOnlyList<PinDto> Pins
  }
  class PinDto {
    +Guid TeammateId
    +string Name
    +string Colour
    +string CityName
    +string Country
    +Position Position
    +string TimeZoneId
    +WeatherDto? Weather
    +WeatherState WeatherState
    +bool SharesStatus
    +bool IsViewer
    +IReadOnlyList<MomentDto> Moments
  }
}

GlobePage ..> TeamStore : reads
GlobePage ..> pinViews : makes views with
GlobePage ..> placePins : places with
placePins ..> groupPins : groups with
placePins ..> placeLabels : sides labels with
GlobePage ..> stillViewport : on the still picture
GlobeView ..> GlobeScene : projects with
GlobeView ..> GlobeViewport : emits
GlobeView ..> PinLayer : [pins] slot
GlobeFallback ..> PinLayer : [pins] slot
PinPlacement "1" o-- "1..*" PinView
GetPinsQueryHandler ..> GetPinsQuery : handles
GetPinsQueryHandler ..> TeamPinsDto : returns
TeamPinsDto "1" o-- "*" PinDto
PinDto ..> Pin : serialised as
@enduml
