@startuml
title UML sequence behaviour — Lift a pin on hover, focus or tap
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "PinLayer" as layer
  participant "GlobeView" as view
  participant "GlobePage" as page
  participant "TeamStore" as store
end box
alt pointer moves over a pin (L2-012 AC1)
  actor -> layer : pointerenter on the pin's 44 x 44 px hit area
  layer -> layer : liftedKey = the placement's key: raise, grow, bring to front, show the label
  layer --> actor : Lifted pin with name, city and local time, within 200 ms
  actor -> layer : pointerleave
  layer -> layer : liftedKey = null; settles unless selected (L2-012 AC2)
  layer --> actor : Pin settles back
else Tab moves to a pin (L2-012 AC3)
  actor -> layer : Focus the pin's button
  layer -> layer : liftedKey = the placement's key
  layer --> actor : Pin lifts exactly as under the pointer, with a focus indicator
  actor -> layer : Enter or Space
else tap on a touch device (L2-012 AC4)
  actor -> layer : Tap a pin
end
layer --> page : selectPin(teammate id)
page -> store : Set the selected teammate id
page -> view : facing = the pin's position: turn to it and hold (L2-009)
page -> layer : selectedId
layer --> actor : Pin stands alone and stays lifted while selected (L2-012 AC5)
actor -> view : Tap elsewhere on the globe
view --> page : blankTap
page -> store : Clear the selection
page -> view : facing = null
layer --> actor : Pin settles back
@enduml
