@startuml
title UML sequence behaviour — Lift a pin on hover, focus or tap
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "PinList" as list
  participant "PinLayer" as layer
  participant "GlobeView" as view
  participant "GlobePage" as page
  participant "TeamStore" as store
end box
alt pointer moves over a pin (L2-012 AC1)
  actor -> layer : pointerenter on the pin's 44 x 44 px hit area
  layer -> layer : liftedId = teammate id: raise, grow, bring to front, show the label
  layer --> actor : Lifted pin with name, city, local time and weather, within 200 ms
  actor -> layer : pointerleave
  layer -> layer : liftedId = null unless selected (L2-012 AC2)
  layer --> actor : Pin settles back
else Tab moves to a pin (L2-012 AC3)
  actor -> list : Focus the pin's button
  list --> view : focusedId(teammate id)
  view -> layer : focusedId input
  layer --> actor : Pin lifts exactly as under the pointer, with a focus indicator
  actor -> list : Enter or Space
  list --> view : select(teammate id)
else tap on a touch device (L2-012 AC4)
  actor -> layer : Tap a pin
  layer --> view : select(teammate id)
end
view --> page : select(teammate id)
page -> store : Set the selected teammate id
store --> page : selectedId changed
page -> view : selectedId input
view -> layer : selectedId input
layer --> actor : Pin stays lifted while selected (L2-012 AC5)
actor -> view : Tap elsewhere on the globe
view --> page : select(null)
page -> store : Clear the selected teammate id
page -> view : selectedId input = null
layer --> actor : Pin settles back
@enduml
