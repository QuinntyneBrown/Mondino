@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show local time and status


Container(api, "Mondino API", "ASP.NET Core", "GET /api/teams/{teamId}/pins: time zone id per pin, no local time")

Container_Boundary(web, "Mondino web app") {
  Component(page, "GlobePage, TeamPage", "Angular pages, mondino", "Derive each pin's local time and status on every minute tick")
  Component(store, "TeamStore", "domain, pins/", "Holds the team's pins as a signal")
  Component(clock, "BrowserClock", "domain, time/", "The one shared Clock; ticks on the minute, rests while hidden")
  Component(local, "localTime, formatTime", "domain, time/", "Wall-clock time in an IANA time zone, as 24-hour or 12-hour text")
  Component(status, "statusAt, statusFor", "domain, time/", "Status from the local hour, hidden where the flag says so")
  Component(views, "PinLabel, TeammatePanel, TeamTable, StatusBadge", "components", "Show the time as text and the status as words")
}
Rel(store, api, "Reads pins through TEAM_API", "JSON/HTTPS")
Rel(page, store, "Reads pins")
Rel(page, clock, "Reads minute through CLOCK")
Rel(page, local, "Calls")
Rel(page, status, "Calls")
Rel(page, views, "Binds inputs")
@enduml
