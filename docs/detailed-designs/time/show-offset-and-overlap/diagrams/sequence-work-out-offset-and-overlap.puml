@startuml
title UML sequence behaviour — work out the offset and the overlap for a selected teammate
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Teammate (viewer)" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "GlobePage" as page
  participant "TeamStore" as store
  participant "BrowserClock" as clock
  participant "offsetBetween,\nformatOffset" as offset
  participant "overlapBetween,\nformatOverlap" as overlap
  participant "TeammatePanel" as panel
  participant "OverlapBar" as bar
end box

actor -> page : Select a teammate's pin
page -> store : select(teammateId), following the address
store --> page : Selected pin and viewer's pin
page -> clock : Read minute through CLOCK
clock --> page : now

note over page, overlap : GlobePage makes the calls below through teammatePanelView\n(team/view-teammate-panel), which builds the panel's content
alt the selected pin is the viewer's own
  page -> panel : Bind offset null and overlap null
  panel --> actor : Panel with no offset and no overlap (L2-016, L2-017)
else another teammate
  page -> offset : offsetBetween(now, pin.timeZoneId, viewerPin.timeZoneId)
  offset -> offset : zoneOffsetMinutes of each zone at now, subtract
  offset --> page : Offset: minutes, direction
  page -> offset : formatOffset(offset, 'panel')
  offset --> page : "7 h behind you", "10 h ahead of you" or "Same time as you" (L2-016)

  page -> overlap : workingDayOnViewerClock(now, pin.timeZoneId, viewerPin.timeZoneId)
  overlap -> overlap : Move the teammate's 09:00 to 18:00 onto the viewer's clock
  overlap --> page : DaySpan: the teammate's working day on the viewer's clock
  page -> overlap : overlapBetween(now, pin.timeZoneId, viewerPin.timeZoneId)
  overlap -> overlap : Intersect with the viewer's 09:00 to 18:00
  alt the working days coincide
    overlap --> page : Overlap: startMinute, endMinute, lengthMinutes
  else no shared working hours
    overlap --> page : null
  end
  page -> overlap : formatOverlap(overlap, theirDay, first name, viewer's ClockFormat)
  overlap --> page : OverlapText: start, end and length, or no shared working hours\nand the teammate's working day (L2-017)

  page -> panel : Bind content: offset text, overlap, the teammate's DaySpan and OverlapText
  panel -> bar : Bind overlap, theirDay, nowMinute, first name and text
  bar --> actor : Both working days on the viewer's day, with the overlap as text (L2-017)
  panel --> actor : Offset as text (L2-016)
end
@enduml
