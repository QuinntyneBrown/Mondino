@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show offset and overlap


Person(teammate, "Teammate", "Selects a teammate's pin")
System_Boundary(mondino, "Mondino") {
  Container(web, "Mondino web app", "Angular", "Works out the offset and the overlap from two time zones and one clock")
  Container(api, "Mondino API", "ASP.NET Core", "Gives each pin's IANA time zone")
  ContainerDb(db, "Mondino database", "TO SUPPLY", "Teammates and their cities")
}
Rel(teammate, web, "Uses", "HTTPS")
Rel(web, api, "Reads the team's pins", "JSON/HTTPS")
Rel(api, db, "Reads", "EF Core")
@enduml
