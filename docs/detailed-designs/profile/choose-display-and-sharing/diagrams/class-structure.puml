@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Choose display and sharing

package "Frontend" {
  class ProfileStore {
    +profile: Signal<Profile>
    +settings: Signal<Settings>
    +locationChanged: Signal<boolean>
    +settingsChanged: Signal<boolean>
    +hasUnsavedChanges: Signal<boolean>
    +saveState: Signal<SaveState>
    +barState: Signal<SaveBarState>
    +setTemperatureUnit(unit): void
    +setClockFormat(format): void
    +setMomentKind(kind, on): void
    +setSharesWeather(on): void
    +setSharesStatus(on): void
    +save(): Promise<SaveResult>
  }
  enum SaveState {
    idle
    saving
    saved
    failed
  }
  enum SaveBarState {
    hidden
    unsaved
    saving
    saved
    failed
  }
  class SaveBar {
    +state: SaveBarState
    +save: Output
    +retry: Output
  }
  class Segmented {
    +mode: "tabs" | "radio"
    +options: Option[]
    +value: string
    +valueChange: Output
  }
  class Switch {
    +checked: boolean
    +label: string
    +hint: string?
    +checkedChange: Output
  }
  class ProfilePage {
    +canLeave(): Promise<boolean>
  }
  class DiscardChangesDialog
  class unsavedChangesGuard << (F,#D1E9FF) function >>
  interface SettingsStore {
    +momentKinds: Signal<MomentKind[]>
    +temperatureUnit: Signal<TemperatureUnit?>
    +clockFormat: Signal<ClockFormat?>
    +replace(settings: Settings): void
  }
  class SettingsCache {
    -mondino.settings: unit, clock, kinds
  }
  class Settings {
    +temperatureUnit: TemperatureUnit
    +clockFormat: ClockFormat
    +momentKinds: MomentKind[]
    +sharesWeather: boolean
    +sharesStatus: boolean
  }
}

package "Backend" {
  class UpdateProfileCommandHandler {
    +Handle(command: UpdateProfileCommand): Task<ProfileDto>
  }
  class UpdateProfileCommandValidator
  class GetPinsQueryHandler {
    +Handle(query: GetPinsQuery): Task<TeamPinsDto>
  }
  class Teammate {
    +Guid Id
    +TeammateSettings Settings
    +bool SharesWeather
    +bool SharesStatus
    +ChangeSettings(settings: TeammateSettings): void
  }
  class TeammateSettings {
    +TemperatureUnit TemperatureUnit
    +ClockFormat ClockFormat
    +MomentKind[] MomentKinds
    +bool SharesWeather
    +bool SharesStatus
    +{static} DefaultsFor(countryCode: string): TeammateSettings
  }
  enum TemperatureUnit {
    Celsius
    Fahrenheit
  }
  enum ClockFormat {
    TwentyFourHour
    TwelveHour
  }
  class PinDto {
    +Guid TeammateId
    +WeatherDto? Weather
    +WeatherState WeatherState
    +bool SharesStatus
  }
  enum WeatherState {
    Available
    Unavailable
    NotShared
  }
  class TeamPinsDto {
    +IReadOnlyList<PinDto> Pins
  }
}

ProfilePage --> ProfileStore : reads / sends changes
ProfilePage --> SaveBar : state
ProfilePage --> Segmented : unit, clock format (mode radio)
ProfilePage --> Switch : four kinds, two sharing switches
ProfileStore --> SaveState : has
SaveBar --> SaveBarState : shows
ProfileStore --> Settings : draft and saved
ProfileStore ..> SettingsStore : publishes on save
SettingsCache ..|> SettingsStore
unsavedChangesGuard ..> ProfilePage : canLeave()
ProfilePage ..> DiscardChangesDialog : opens
ProfileStore ..> UpdateProfileCommandHandler : PUT through ProfileApi
UpdateProfileCommandHandler ..> UpdateProfileCommandValidator : validated by
UpdateProfileCommandHandler --> Teammate : ChangeSettings
Teammate *-- TeammateSettings
TeammateSettings --> TemperatureUnit
TeammateSettings --> ClockFormat
GetPinsQueryHandler ..> TeammateSettings : reads the switches
GetPinsQueryHandler ..> TeamPinsDto : returns
TeamPinsDto *-- PinDto : built per viewer
PinDto --> WeatherState
@enduml
