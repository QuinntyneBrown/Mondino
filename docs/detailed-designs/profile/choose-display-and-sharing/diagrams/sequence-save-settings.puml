@startuml
title UML sequence behaviour — Save display and sharing settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "ProfilePage" as page
  participant "SaveBar" as bar
  participant "ProfileStore" as store
  participant "HttpProfileApi" as client
  participant "SettingsStore" as settings
end box
box "Backend — Mondino API" #D1FADF
  participant "ProfileController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "UpdateProfileCommandHandler" as handler
  participant "Teammate" as entity
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  database "Mondino database" as db
end box
actor -> page : Choose °F, the 12-hour clock; switch off "Share my local weather"
page -> store : changeSettings(patch)
store -> store : draft differs from saved; hasUnsavedChanges = true
store --> bar : state = unsaved
bar --> actor : "You have unsaved changes" and "Save changes" (L2-035)
actor -> bar : Use "Save changes"
bar -> page : save
page -> store : save()
store --> bar : state = saving
store -> client : updateProfile(teamId, draft)
client -> controller : PUT /api/teams/{teamId}/me
controller -> controller : Authenticate the session; check the anti-forgery token
controller -> handler : Send UpdateProfileCommand
alt save succeeds
  handler -> handler : UpdateProfileCommandValidator
  handler -> db : Load the teammate ICurrentTeammate names
  db --> handler : Teammate
  handler -> entity : ChangeSettings(settings) (L2-033, L2-034)
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : ProfileDto
  controller --> client : 200 ProfileDto
  client --> store : Profile
  store -> store : saved = response; hasUnsavedChanges = false
  store -> settings : replace(settings); SettingsCache is written
  settings --> page : Every local time and temperature uses the new choice (L2-033)
  store --> bar : state = saved
  bar --> actor : "Saved — your pin is up to date", announced (L2-035)
  store -> store : After 4 seconds: state = hidden
else save fails
  controller --> client : ProblemDetails, or no answer
  client --> store : ApiError
  store -> store : The draft is kept; hasUnsavedChanges stays true
  store --> bar : state = failed
  bar --> actor : The changes could not be saved; "Try again" (L2-035)
  actor -> bar : Use "Try again"
  bar -> page : retry
  page -> store : save()
end
@enduml
