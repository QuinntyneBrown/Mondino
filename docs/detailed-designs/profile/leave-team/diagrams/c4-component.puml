@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Leave team

Container_Boundary(spa, "Mondino web app") {
  Component(page, "ProfilePage", "Angular page, lazy route", "The button that opens the dialog")
  Component(dialog, "LeaveTeamDialog", "CDK Dialog", "Names the team; stay or leave; busy and failed")
  Component(store, "ProfileStore", "Route-scoped signal store", "Leaves, clears the settings and the membership, navigates")
  Component(client, "HttpProfileApi", "ProfileApi over HTTP", "Sends the DELETE")
  Component(left, "LeftPage", "Angular page, lazy route", "Confirms the teammate has left; team name from the navigation state, then out of history")
}
Container_Boundary(api, "Mondino API") {
  Component(ctrl, "ProfileController", "ASP.NET Core controller", "DELETE /api/teams/{teamId}/me")
  Component(handler, "LeaveTeamCommandHandler", "MediatR handler", "Removes the current teammate and their sign-in links")
  Component(sessions, "CookieTeammateSessions", "ITeammateSessions", "Expires the session and antiforgery cookies")
  ComponentDb(db, "Mondino database", "EF Core", "Teammate rows and sign-in links")
}

Rel(page, dialog, "Opens")
Rel(dialog, store, "leave(); reads leaving and leaveFailed")
Rel(store, client, "Calls through PROFILE_API")
Rel(store, left, "Navigates to /left")
Rel(client, ctrl, "DELETE", "HTTPS")
Rel(ctrl, handler, "Sends LeaveTeamCommand")
Rel(handler, db, "Deletes the teammate's row and sign-in links in one unit of work", "IAppDbContext")
Rel(handler, sessions, "Ends the session")
@enduml
