@startuml
title UML sequence behaviour — Confirm leaving the team
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "ProfilePage" as page
  participant "LeaveTeamDialog" as dialog
  participant "ProfileStore" as store
  participant "HttpProfileApi" as client
  participant "LeftPage" as left
end box
box "Backend — Mondino API" #D1FADF
  participant "ProfileController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "LeaveTeamCommandHandler" as handler
  participant "Team" as team
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  participant "TeammateSessions" as sessions
  database "Mondino database" as db
end box
actor -> page : Choose "Leave Northwind"
page -> dialog : Open through CDK Dialog with the team's name
dialog --> actor : "Leave Northwind?", says the pin comes off the globe for all 12 teammates; "Stay" or "Leave Northwind". Nothing is removed yet (L2-036)
actor -> dialog : Use "Leave Northwind"
dialog -> store : leave()
store -> store : leaving = true
dialog --> actor : Stays open; both buttons disabled, "Leaving…"
store -> client : leaveTeam(teamId)
client -> controller : DELETE /api/teams/{teamId}/me
controller -> controller : Authenticate the session; check the anti-forgery token
controller -> handler : Send LeaveTeamCommand (no teammate id)
handler -> db : Load the Team with the teammate ICurrentTeammate names
db --> handler : Team
alt left
  handler -> team : RemoveTeammate(teammateId)
  team --> handler : Teammate removed with name, postal code, city and settings
  handler -> sessions : EndAllAsync(teammateId)
  sessions --> handler : Sessions deleted; cookie expired on the response
  handler -> db : Save changes in one unit of work (L2-036)
  db --> handler : Commit result
  handler --> controller : Done
  controller --> client : 204 No Content, session cookie expired
  client --> store : Done
  store -> store : Discard the draft; clear SettingsStore and SettingsCache; TeamMembership.forget()
  store -> left : Navigate to /left with the team's name in the navigation state, replacing /profile; the dialog closes
  left --> actor : "You’ve left Northwind" ("You’ve left the team" when reloaded): "Start a new team" and "Sign in to another team"
else the request fails
  controller --> client : ProblemDetails, or no answer
  client --> store : ApiError
  store -> store : leaving = false; leaveFailed = true; nothing is cleared
  dialog --> actor : Alert in the dialog: "We couldn’t take your pin off. You’re still on Northwind — try again."; "Try again". The pin stays
end
note over page, db : At their next read of GET /api/teams/{teamId}/pins, every other teammate receives no pin for the teammate who left.\nThe old session is refused with 401 from now on.
@enduml
