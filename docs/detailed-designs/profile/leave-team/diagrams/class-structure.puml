@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Leave team

package "Frontend" {
  class ProfilePage {
    +openLeaveDialog(): void
  }
  class LeaveTeamDialog {
    +teamName: string
    +cancel(): void
    +leave(): void
  }
  enum LeaveDecision {
    leave
    cancel
  }
  class ProfileStore {
    +leaving: Signal<boolean>
    +leaveFailed: Signal<boolean>
    +leave(): void
  }
  interface ProfileApi {
    +leaveTeam(teamId: string): Promise<void>
  }
  class HttpProfileApi
  class LeftPage
  class SettingsStore {
    +clear(): void
  }
  class SettingsCache {
    +clear(): void
  }
}

package "Backend" {
  class ProfileController {
    +Delete(teamId: Guid): Task<IActionResult>
  }
  class LeaveTeamCommand {
    +Guid TeamId
  }
  class LeaveTeamCommandHandler {
    +Handle(command: LeaveTeamCommand): Task
  }
  interface ICurrentTeammate {
    +Guid TeammateId
    +Guid TeamId
  }
  interface ITeammateSessions {
    +EndAllAsync(teammateId: Guid): Task
  }
  class TeammateSessions
  interface IAppDbContext {
    +SaveChangesAsync(): Task<int>
  }
  class Team {
    +Guid Id
    +string Name
    +IReadOnlyList<Teammate> Teammates
    +RemoveTeammate(teammateId: Guid): void
  }
  class Teammate {
    +Guid Id
    +string Name
    +string Colour
    +PostalCode PostalCode
    +City City
    +TeammateSettings Settings
  }
  class PostalCode
  class City
  class TeammateSettings
}

ProfilePage ..> LeaveTeamDialog : opens (CDK Dialog)
LeaveTeamDialog --> LeaveDecision : closes with
ProfilePage --> ProfileStore : leave()
ProfileStore ..> ProfileApi : PROFILE_API
ProfileApi <|.. HttpProfileApi
ProfileStore ..> SettingsStore : clears
SettingsStore ..> SettingsCache : clears
ProfileStore ..> LeftPage : navigates to
HttpProfileApi ..> ProfileController : DELETE
ProfileController ..> LeaveTeamCommandHandler : LeaveTeamCommand
LeaveTeamCommandHandler ..> LeaveTeamCommand : handles
LeaveTeamCommandHandler ..> ICurrentTeammate : who leaves
LeaveTeamCommandHandler --> Team : loads / RemoveTeammate
LeaveTeamCommandHandler ..> ITeammateSessions : ends sessions
LeaveTeamCommandHandler ..> IAppDbContext : saves
ITeammateSessions <|.. TeammateSessions
Team "1" *-- "0..500" Teammate
Teammate *-- PostalCode
Teammate *-- City
Teammate *-- TeammateSettings
@enduml
