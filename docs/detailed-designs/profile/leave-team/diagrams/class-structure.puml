@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Leave team

package "Frontend" {
  class ProfilePage {
    +openLeaveDialog(trigger: HTMLElement): void
  }
  class LeaveTeamDialog {
    +teamName: Signal<string>
    +teammates: Signal<number>
    +leave(): void
  }
  class ProfileStore {
    +leaving: Signal<boolean>
    +leaveFailed: Signal<boolean>
    +leave(): Promise<void>
  }
  interface ProfileApi {
    +leaveTeam(teamId: string, signal: AbortSignal): Promise<void>
  }
  class HttpProfileApi
  class LeftPage {
    +teamName: string | null
  }
  interface SettingsStore {
    +clear(): void
  }
  class SettingsCache {
    +clear(): void
  }
  interface TeamMembership {
    +forget(): void
  }
}

package "Backend" {
  class ProfileController {
    +Delete(teamId: Guid): Task<IActionResult>
  }
  class LeaveTeamCommand {
    +Guid TeamId
  }
  class LeaveTeamCommandHandler {
    +Handle(command: LeaveTeamCommand): Task
  }
  interface ICurrentTeammate {
    +Guid TeammateId
    +Guid TeamId
  }
  interface ITeammateSessions {
    +EndAsync(): Task
  }
  class TeammateSessions
  interface IAppDbContext {
    +Teammates: DbSet<Teammate>
    +SignInLinks: DbSet<SignInLink>
    +SaveChangesAsync(): Task<int>
  }
  class Team {
    +Guid Id
    +string Name
    +string InviteToken
  }
  class Teammate {
    +Guid Id
    +string Name
    +string Colour
    +string? PostalCode
    +City City
    +string? EmailFingerprint
    +TeammateSettings Settings
  }
  class SignInLink {
    +string EmailFingerprint
    +byte[] SealedEmail
  }
  class City
  class TeammateSettings
}

ProfilePage ..> LeaveTeamDialog : opens (CDK Dialog)
LeaveTeamDialog --> ProfileStore : leave() / leaving, leaveFailed
ProfileStore ..> ProfileApi : PROFILE_API
ProfileApi <|.. HttpProfileApi
ProfileStore ..> SettingsStore : clear()
SettingsStore <|.. SettingsCache
ProfileStore ..> TeamMembership : forget()
ProfileStore ..> LeftPage : navigates to
HttpProfileApi ..> ProfileController : DELETE
ProfileController ..> LeaveTeamCommandHandler : LeaveTeamCommand
LeaveTeamCommandHandler ..> LeaveTeamCommand : handles
LeaveTeamCommandHandler ..> ICurrentTeammate : who leaves
LeaveTeamCommandHandler ..> ITeammateSessions : ends the session
LeaveTeamCommandHandler ..> IAppDbContext : removes the Teammate and their SignInLinks
ITeammateSessions <|.. TeammateSessions
Team "1" o-- "0..500" Teammate : kept when the last leaves
Teammate --> City
SignInLink ..> Teammate : same fingerprint
Teammate *-- TeammateSettings
@enduml
