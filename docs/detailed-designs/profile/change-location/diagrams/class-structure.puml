@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Change location

package "Frontend" {
  interface ProfileApi {
    +getProfile(teamId: string): Promise<Profile>
    +lookUpPostalCode(teamId: string, countryCode: string, postalCode: string, signal: AbortSignal): Promise<PostalCodeResult>
    +updateProfile(teamId: string, update: ProfileUpdate): Promise<Profile>
  }
  class HttpProfileApi
  class ProfileStore {
    +saved: Signal<Profile>
    +draft: Signal<ProfileUpdate>
    +lookupState: Signal<LookupState>
    +load(): void
    +changeCountry(countryCode: string): void
    +changePostalCode(value: string): void
    +lookUp(): void
    +save(): void
  }
  class ProfilePage
  class Profile {
    +teamName: string
    +pin: Pin
    +countryCode: string
    +postalCode: string
    +settings: Settings
    +countries: Country[]
  }
  class ProfileUpdate {
    +countryCode: string
    +postalCode: string
    +settings: Settings
  }
  enum LookupState {
    Idle
    Locating
    Found
    NotFound
    Unavailable
    RateLimited
  }
  class PostalCodeField {
    +value: string
    +country: Country
    +lookupState: LookupState
    +message: LookupMessage | null
    +invalid: boolean
    +valueChange: string
    +blurred: void
    +retry: void
  }
  class LookupMessage {
    +text: string
    +retryLabel: string | null
  }
  class Country {
    +code: string
    +name: string
    +postalCodeHint: string
  }
  class profileLookupMessage << (F,#D1E9FF) function >> {
    +(lookupState: LookupState, postalCode: string, country: Country, savedCity: string): LookupMessage | null
  }
}

package "Backend" {
  class ProfileController {
    +Get(teamId: Guid): Task<ProfileDto>
    +Put(teamId: Guid, body): Task<ProfileDto>
    +LookUpPostalCode(teamId: Guid, body): Task<PostalCodeResultDto>
  }
  class UpdateProfileCommand {
    +Guid TeamId
    +string CountryCode
    +string PostalCode
    +TeammateSettings Settings
  }
  class UpdateProfileCommandHandler {
    +Handle(command: UpdateProfileCommand): Task<ProfileDto>
  }
  class LookUpOwnPostalCodeQuery {
    +Guid TeamId
    +string CountryCode
    +string PostalCode
  }
  class LookUpOwnPostalCodeQueryHandler {
    +Handle(query: LookUpOwnPostalCodeQuery): Task<PostalCodeResultDto>
  }
  class ProfileDto {
    +string TeamName
    +PinDto Pin
    +string CountryCode
    +string PostalCode
    +SettingsDto Settings
    +IReadOnlyList<CountryDto> Countries
  }
  class GetProfileQueryHandler {
    +Handle(query: GetProfileQuery): Task<ProfileDto>
  }
  interface ICurrentTeammate {
    +Guid TeammateId
    +Guid TeamId
  }
  class PostalCodeResolver {
    +ResolveAsync(countryCode: string, postalCode: string, ct): Task<PostalCodeResolution>
  }
  class PostalCodeResolution {
    +PostalCodeLookupStatus Status
    +PostalCode? PostalCode
    +City? City
  }
  interface IPostalCodeLookup {
    +FindCityAsync(postalCode: PostalCode, ct): Task<PostalCodeLookupOutcome>
  }
  class PostalCodeLookupOutcome {
    +PostalCodeLookupStatus Status
    +City? City
  }
  enum PostalCodeLookupStatus {
    Found
    NotFound
    Unavailable
  }
  class PostalCodeFormats {
    +IReadOnlyList<PostalCodeFormat> Supported
    +TryNormalise(countryCode: string, value: string, out postalCode: PostalCode): bool
  }
  class Teammate {
    +Guid Id
    +Guid TeamId
    +string CountryCode
    +PostalCode PostalCode
    +City City
    +MoveTo(postalCode: PostalCode, city: City): void
  }
  class City {
    +string Name
    +string Region
    +string CountryCode
    +Position Position
    +string TimeZoneId
  }
  class Position {
    +double Latitude
    +double Longitude
  }
  class PostalCode {
    +string CountryCode
    +string Value
  }
}

ProfilePage --> ProfileStore : reads / sends changes
ProfileStore ..> ProfileApi : PROFILE_API
ProfileApi <|.. HttpProfileApi
ProfileStore --> Profile : saved
ProfileStore --> ProfileUpdate : draft
ProfileStore --> LookupState : has
ProfilePage --> PostalCodeField : value, country, lookupState, message, invalid
PostalCodeField ..> Country : the chosen country
Profile --> Country : countries
ProfilePage ..> profileLookupMessage : this screen's copy
profileLookupMessage ..> LookupMessage : builds
PostalCodeField ..> LookupMessage : renders
PostalCodeField ..> LookupState : shows
IPostalCodeLookup ..> PostalCodeLookupOutcome : returns
PostalCodeLookupOutcome --> PostalCodeLookupStatus
PostalCodeLookupOutcome --> City
HttpProfileApi ..> ProfileController : JSON/HTTPS
ProfileController ..> GetProfileQueryHandler : GetProfileQuery
ProfileController ..> LookUpOwnPostalCodeQueryHandler : LookUpOwnPostalCodeQuery
LookUpOwnPostalCodeQueryHandler ..> LookUpOwnPostalCodeQuery : handles
LookUpOwnPostalCodeQueryHandler ..> ICurrentTeammate : whose team
GetProfileQueryHandler ..> ProfileDto : builds
GetProfileQueryHandler ..> PostalCodeFormats : Countries
ProfileController ..> UpdateProfileCommandHandler : UpdateProfileCommand
UpdateProfileCommandHandler ..> UpdateProfileCommand : handles
UpdateProfileCommandHandler ..> ICurrentTeammate : whose pin
UpdateProfileCommandHandler ..> PostalCodeResolver : resolves the city
PostalCodeResolver ..> PostalCodeFormats : normalises with
PostalCodeResolver ..> IPostalCodeLookup : finds the city
PostalCodeResolver ..> PostalCodeResolution : returns
PostalCodeResolution --> PostalCodeLookupStatus
UpdateProfileCommandHandler --> Teammate : loads / moves
LookUpOwnPostalCodeQueryHandler ..> PostalCodeResolver : resolves the city
GetProfileQueryHandler ..> ICurrentTeammate : whose profile
Teammate *-- PostalCode
Teammate *-- City
City *-- Position
@enduml
