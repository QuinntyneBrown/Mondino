@startuml
title UML sequence behaviour — Open the profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "ProfilePage" as page
  participant "ProfileStore" as store
  participant "HttpProfileApi" as client
  participant "GlobeView" as globe
end box
box "Backend — Mondino API" #D1FADF
  participant "ProfileController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "GetProfileQueryHandler" as handler
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  participant "CachedWeatherSource" as weather
  database "Mondino database" as db
end box
actor -> page : Open /profile
page -> store : load()
page --> actor : Placeholders; "Loading your pin and settings…"
store -> client : getProfile(teamId)
client -> controller : GET /api/teams/{teamId}/me
controller -> controller : TeammateSessionHandler authenticates the session cookie
controller -> handler : Send GetProfileQuery
handler -> db : Load the teammate ICurrentTeammate names
db --> handler : Teammate with PostalCode, City, Settings
alt teamId is not the teammate's own team (TeamScopeBehaviour, before the handler)
  handler --> controller : team_not_found
  controller --> client : 404 ProblemDetails, code team_not_found
else own team
  handler -> weather : Weather at City.Position
  weather --> handler : Weather, or none when the source fails
  handler --> controller : ProfileDto with own postal code only (L2-031) and the supported Countries
  controller --> client : 200 ProfileDto
end
client --> store : Profile, or ApiError when the read fails
note over page : When the read fails: "We couldn’t load your pin", "Try again" and "Back to the globe".
store --> page : saved and draft signals
page -> globe : Import @mondino/globe dynamically; one pin in pins, named in selectedId, interactive = false
globe --> page : Small globe that does not turn and cannot be dragged (L2-031)
page --> actor : "Your pin": city, country, local time, time zone, the privacy reminder
@enduml
