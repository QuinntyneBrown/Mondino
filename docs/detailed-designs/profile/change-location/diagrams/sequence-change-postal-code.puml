@startuml
title UML sequence behaviour — Change the postal code
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Teammate" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "PostalCodeField" as field
  participant "ProfileStore" as store
  participant "HttpProfileApi" as client
end box
box "Backend — Mondino API" #D1FADF
  participant "ProfileController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "TeamScopeBehaviour" as scope
  participant "LookUpOwnPostalCodeQueryHandler" as handler
  participant "PostalCodeResolver" as resolver
  participant "PostalCodeFormats" as formats
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  participant "CachedPostalCodeLookup" as lookup
  participant "CachedWeatherSource" as weather
end box
participant "Postal code source" as source
participant "Open-Meteo" as meteo
actor -> field : Change the country or postal code, leave the field
field -> store : changePostalCode(value); on blurred, lookUp() (nothing while empty or the same as saved)
store -> store : Keep what was typed; clear the found city; the draft's location is the saved one; lookupState = Locating
field --> actor : "Finding M5V 2T6…"
store -> client : lookUpPostalCode(teamId, countryCode, postalCode, signal)
client -> controller : POST /api/teams/{teamId}/me/postal-code-lookups (postal code in the body)
controller -> controller : Authenticate the session; apply the lookup rate limit
controller -> scope : Send LookUpOwnPostalCodeQuery
scope -> handler : teamId is the current teammate's own team, or 404 team_not_found
handler -> resolver : ResolveAsync(countryCode, postalCode)
resolver -> formats : TryNormalise(countryCode, postalCode)
alt wrong form for the country
  formats --> resolver : No match
  resolver --> handler : NotFound; the source is not called
  handler --> controller : postal_code_not_found
else right form
  formats --> resolver : PostalCode
  resolver -> lookup : FindCityAsync(postalCode)
  lookup -> source : Country and postal code only
  alt found
    source --> lookup : City, position, time zone
    lookup --> resolver : Found, City
    resolver --> handler : PostalCodeResolution: Found, PostalCode, City
    handler -> weather : Weather at City.Position
    weather -> meteo : Position only
    meteo --> weather : Current weather
    weather --> handler : Weather or none
    handler --> controller : PostalCodeResultDto
  else not known to the source
    source --> lookup : No city
    lookup --> resolver : NotFound
    resolver --> handler : PostalCodeResolution: NotFound
    handler --> controller : postal_code_not_found
  else no answer within 5 seconds
    lookup --> resolver : Unavailable
    resolver --> handler : PostalCodeResolution: Unavailable
    handler --> controller : postal_code_unavailable
  end
end
controller --> client : 200 PostalCodeResultDto, or ProblemDetails with a code
client --> store : PostalCodeResult or ApiError
alt found
  store -> store : lookupState = Found; the draft takes the typed country and postal code
  field --> actor : City and region, "your pin moves here when you save"; the small globe shows the pin there as new; the save bar shows
else postal_code_not_found
  store -> store : lookupState = NotFound; nothing to save
  field --> actor : Alert of L2-004, ending "Your pin stays in Milan.", aria-invalid on the input; saving is not offered; the pin stays (L2-032)
else postal_code_unavailable, any other code, or no answer
  store -> store : lookupState = Unavailable; nothing to save
  field --> actor : Could not be checked right now, "Your pin stays in Milan."; "Try again" emits retry, which runs lookUp() again (L2-032)
else rate_limited (429 from the lookup rate limit, before the handler)
  store -> store : lookupState = RateLimited; nothing to save
  field --> actor : Wait a moment, then try again, "Your pin stays in Milan."; what was typed is kept (L2-032)
end
@enduml
