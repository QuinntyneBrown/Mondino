@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Make a team

Container(web, "Mondino web app", "Angular", "CreateTeamPage, CreateTeamStore, HttpTeamCreationApi, CopyField, Toast, GlobeView")
Container_Boundary(api, "Mondino API") {
  Component(ctrl, "TeamCreationController", "ASP.NET Core controller", "Open to anyone; the lookup and city search rate limited, making a team not")
  Component(lookupq, "LookUpPostalCodeQueryHandler", "MediatR handler", "The lookup Join uses, with no invite token")
  Component(validator, "CreateTeamCommandValidator", "Validator", "Team name, name, email, country and postal code limits")
  Component(fingerprints, "HmacEmailFingerprints", "IEmailFingerprints", "Keyed fingerprint of the email; the address is not kept")
  Component(handler, "CreateTeamCommandHandler", "MediatR handler", "Makes the team and its first teammate exactly once")
  Component(tokens, "InviteTokens", "IInviteTokens", "Makes the invite token")
  Component(lookup, "CachedPostalCodeLookup", "IPostalCodeLookup decorator", "Finds the city of the postal code")
  Component(team, "Team", "Domain entity", "Create, AddTeammate")
  Component(session, "TeammateSessionHandler", "Cookie session authentication", "Issues the HttpOnly, Secure, SameSite cookie")
  ComponentDb(db, "Mondino database", "EF Core, IAppDbContext", "Teams and teammates")
}
Rel(web, ctrl, "POST postal-code-lookups, POST city-searches, POST teams", "JSON/HTTPS")
Rel(ctrl, lookupq, "LookUpPostalCodeQuery", "MediatR")
Rel(ctrl, validator, "CreateTeamCommand passes through", "MediatR pipeline")
Rel(validator, handler, "Valid command")
Rel(lookupq, lookup, "FindCityAsync(postalCode)")
Rel(handler, lookup, "FindCityAsync(postalCode)")
Rel(handler, tokens, "Create()")
Rel(handler, fingerprints, "FingerprintOf(email)")
Rel(handler, team, "Create, AddTeammate")
Rel(handler, db, "Saves in one unit of work", "EF Core")
Rel(ctrl, session, "Signs the maker in")
@enduml
