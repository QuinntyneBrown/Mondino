@startuml
title UML sequence behaviour — Open an invalid invite link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Person with an invite link" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "JoinPage" as page
  participant "JoinStore" as store
  participant "HttpInviteApi" as client
end box
box "Backend — Mondino API" #D1FADF
  participant "InvitesController" as controller
  participant "ProblemDetailsWriter" as problems
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "GetInviteQueryHandler" as handler
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  database "Mondino database" as db
end box
actor -> page : Open /join/:inviteToken
page -> store : open(inviteToken)
store -> client : getInvite(inviteToken)
client -> controller : GET /api/invites/{inviteToken}
alt more than 30 opens in a minute from this client
  controller -> problems : Rate limit policy rejects
  problems --> client : 429 ProblemDetails, code rate_limited, Retry-After
  client --> store : ApiError rate_limited
  store --> page : inviteState Failed
  page --> actor : "We couldn’t open this invite"; offer "Try again" (L2-001)
else within the limit
  controller -> handler : Send GetInviteQuery
  handler -> db : Load the team by invite token
  db --> handler : No team (never issued, mistyped, or reset)
  handler --> controller : Refuse with invite_not_found
  controller -> problems : Write the refusal
  problems --> client : 404 ProblemDetails, code invite_not_found
  client --> store : ApiError invite_not_found
  store --> page : inviteState NotFound
  page --> actor : "This invite link no longer works", "Start your own team";\nno team name, count or pins (L2-001)
end
note over page, client
  When the request gets no answer, JoinStore sets inviteState Failed and JoinPage says
  "We couldn’t open this invite" and offers "Try again", which calls open() again (L2-001).
end note
@enduml
