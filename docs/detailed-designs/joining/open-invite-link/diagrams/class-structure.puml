@startuml
set namespaceSeparator none
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}

title Class structure — Open an invite link

package "mondino application" {
  class JoinPage {
    +inviteToken: string
  }
  class JoinStore {
    +invite: Signal<Invite | null>
    +inviteState: Signal<InviteState>
    +open(inviteToken: string): void
  }
  enum InviteState {
    Loading
    Ready
    AlreadyJoined
    NotFound
    Failed
  }
}
package "@mondino/domain" {
  class TeamMembership {
    +remember(membership: Membership): void
  }
  class SettingsStore {
    +replace(settings: Settings): void
  }
}
package "@mondino/api" {
  interface InviteApi {
    +getInvite(inviteToken: string): Promise<Invite>
  }
  class HttpInviteApi
  class Invite {
    +teamName: string
    +teammateCount: number
    +positions: Position[]
    +avatars: InviteAvatar[]
    +alreadyJoined: boolean
    +countries: Country[]
    +membership: Membership | null
    +settings: Settings | null
  }
  class Membership {
    +teamId: string
    +teammateId: string
    +teamName: string
    +initials: string
    +colour: string
  }
  class InviteAvatar {
    +initials: string
    +colour: string
  }
  class ApiError {
    +code: string
  }
}
package "Mondino.Api" {
  class InvitesController {
    +GetInvite(inviteToken: string): Task<ActionResult<InviteDto>>
  }
}
package "Mondino.Application" {
  class GetInviteQuery {
    +string InviteToken
  }
  class GetInviteQueryHandler {
    +Handle(query: GetInviteQuery): Task<InviteDto>
  }
  class InviteDto {
    +string TeamName
    +int TeammateCount
    +IReadOnlyList<Position> Positions
    +IReadOnlyList<InviteAvatarDto> Avatars
    +bool AlreadyJoined
    +IReadOnlyList<CountryDto> Countries
    +MembershipDto? Membership
    +SettingsDto? Settings
  }
  class MembershipDto {
    +Guid TeamId
    +Guid TeammateId
    +string TeamName
    +string Initials
    +string Colour
  }
  class InviteAvatarDto {
    +string Initials
    +string Colour
  }
  interface ICurrentTeammate {
    +Guid TeammateId
    +Guid TeamId
    +bool IsAuthenticated
  }
  interface IAppDbContext
}
package "Mondino.Domain" {
  class Team {
    +Guid Id
    +string Name
    +string InviteToken
    +IReadOnlyList<Teammate> Teammates
  }
  class Teammate {
    +Guid Id
    +string Name
    +string Colour
    +City City
    +DateTimeOffset JoinedAt
  }
  class City {
    +string Name
    +Position Position
  }
  class Position {
    +double Latitude
    +double Longitude
  }
}

JoinPage --> JoinStore : provides and reads
JoinStore --> InviteState : holds
JoinPage ..> TeamMembership : remembers the membership when already joined
JoinPage ..> SettingsStore : replaces the settings when already joined
InviteDto --> MembershipDto : the session's own, when already joined
JoinStore ..> InviteApi : INVITE_API
HttpInviteApi ..|> InviteApi
InviteApi ..> Invite : returns
Invite --> InviteAvatar : at most five
Invite --> Membership : the session's own, when already joined
InviteApi ..> ApiError : refuses with
HttpInviteApi ..> InvitesController : GET /api/invites/{inviteToken}
InvitesController ..> GetInviteQuery : sends
GetInviteQueryHandler ..> GetInviteQuery : handles
GetInviteQueryHandler ..> InviteDto : builds
GetInviteQueryHandler ..> ICurrentTeammate : asks
GetInviteQueryHandler ..> IAppDbContext : reads
GetInviteQueryHandler --> Team : loads
Team "1" *-- "0..500" Teammate
Teammate --> City
City --> Position
InviteDto --> Position : bare positions
InviteDto --> InviteAvatarDto : the five who joined most recently
@enduml
