@startuml
title UML sequence behaviour — Open a valid invite link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Person with an invite link" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "JoinPage" as page
  participant "JoinStore" as store
  participant "HttpInviteApi" as client
  participant "GlobeView" as globe
end box
box "Backend — Mondino API" #D1FADF
  participant "InvitesController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "GetInviteQueryHandler" as handler
  participant "ICurrentTeammate" as current
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  database "Mondino database" as db
end box
actor -> page : Open /join/:inviteToken
page -> store : open(inviteToken)
store -> client : getInvite(inviteToken)
client -> controller : GET /api/invites/{inviteToken}
controller -> controller : Apply the invite rate limit policy
controller -> handler : Send GetInviteQuery
handler -> db : Load the team by invite token
db --> handler : Team and its teammates' cities, names, colours and joined dates
handler -> current : Session's team
current --> handler : Team id or none
alt the session belongs to a teammate of this team (L2-001)
  handler --> controller : InviteDto, AlreadyJoined true, no positions or avatars
  controller --> client : 200 InviteDto
  client --> store : Invite
  store --> page : inviteState AlreadyJoined
  page --> actor : Navigate to /globe, no second pin
else no session on this team
  handler -> handler : Build bare positions: one city position per teammate, no id, name or city; avatars of the five who joined most recently (L2-001)
  handler --> controller : InviteDto
  controller --> client : 200 InviteDto
  client --> store : Invite
  store --> page : inviteState Ready
  page -> globe : Load dynamically, pass bare pins, not interactive
  page --> actor : "Put yourself on the map.", "Joining Northwind · 11 already here", avatars, globe with 11 pins
end
@enduml
