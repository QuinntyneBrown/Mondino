@startuml
set namespaceSeparator none
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}

title Class structure — Sign in with an emailed link

package "mondino application" {
  class SignInPage
  class SignInStore {
    +email: WritableSignal<string>
    +state: Signal<SignInState>
    +requestLink(): Promise<void>
    +useAnotherEmail(): void
    +open(signInToken: string): Promise<SignInResult | null>
  }
  enum SignInState {
    Idle
    Invalid
    Sending
    Sent
    Failed
    Opening
    LinkUnusable
  }
}
package "@mondino/domain" {
  class TeamMembership {
    +remember(membership: Membership): void
  }
}
package "@mondino/api" {
  interface SignInApi {
    +requestLink(email: string, signal: AbortSignal): Promise<void>
    +redeem(signInToken: string, signal: AbortSignal): Promise<SignInResult>
  }
  class HttpSignInApi
  class SignInResult {
    +membership: Membership | null
    +email: string | null
  }
}
package "Mondino.Api" {
  class SignInController {
    +RequestLink(body: SignInLinkRequest): Task<IActionResult>
    +Redeem(body: SignInRedemptionRequest): Task<ActionResult<SignInResultDto>>
  }
}
package "Mondino.Application" {
  class RequestSignInLinkCommand {
    +string Email
  }
  class RequestSignInLinkCommandValidator
  class RequestSignInLinkCommandHandler {
    +Handle(command: RequestSignInLinkCommand): Task
  }
  class RedeemSignInLinkCommand {
    +string SignInToken
  }
  class RedeemSignInLinkCommandHandler {
    +Handle(command: RedeemSignInLinkCommand): Task<SignInResultDto>
  }
  class SignInResultDto {
    +MembershipDto? Membership
    +string? Email
  }
  interface ISignInTokens {
    +Create(): string
    +Hash(token: string): string
    +Seal(token: string, email: EmailAddress): byte[]
    +Unseal(token: string, sealed: byte[]): EmailAddress?
  }
  interface ISignInMailOutbox {
    +Enqueue(mail: SignInMail): void
  }
  interface ISignInEmailSender {
    +SendAsync(mail: SignInMail, ct): Task<bool>
  }
  interface IEmailFingerprints {
    +FingerprintOf(email: EmailAddress): string
  }
  interface IAppDbContext
}
package "Mondino.Domain" {
  class SignInLink {
    +Guid Id
    +string TokenHash
    +string EmailFingerprint
    +byte[] SealedEmail
    +DateTimeOffset CreatedAt
    +DateTimeOffset ExpiresAt
    +DateTimeOffset? UsedAt
    +{static} TimeSpan Lifetime = 15 minutes
    +TryUse(now: DateTimeOffset): bool
  }
  class EmailAddress {
    +string Value
    +{static} TryParse(text): EmailAddress?
  }
  class Teammate {
    +Guid Id
    +Guid TeamId
    +string? EmailFingerprint
    +DateTimeOffset JoinedAt
  }
}
package "Mondino.Infrastructure" {
  class SignInTokens
  class SignInMailOutbox
  class SignInMailDispatcher
  class PostmarkSignInEmailSender
  class TeammateSessionHandler
}

SignInPage --> SignInStore
SignInPage ..> TeamMembership : remembers the team after signing in
SignInStore --> SignInState
SignInStore ..> SignInApi : SIGN_IN_API
HttpSignInApi ..|> SignInApi
SignInApi ..> SignInResult
SignInController ..> RequestSignInLinkCommand : sends
SignInController ..> RedeemSignInLinkCommand : sends
SignInController ..> TeammateSessionHandler : signs in through
RequestSignInLinkCommandValidator ..> RequestSignInLinkCommand : validates
RequestSignInLinkCommandHandler ..> RequestSignInLinkCommand : handles
RequestSignInLinkCommandHandler ..> ISignInTokens
RequestSignInLinkCommandHandler ..> ISignInMailOutbox
RequestSignInLinkCommandHandler ..> IEmailFingerprints
RedeemSignInLinkCommandHandler ..> IEmailFingerprints
RequestSignInLinkCommandHandler ..> IAppDbContext
RequestSignInLinkCommandHandler ..> SignInLink : creates
RedeemSignInLinkCommandHandler ..> RedeemSignInLinkCommand : handles
RedeemSignInLinkCommandHandler ..> ISignInTokens
RedeemSignInLinkCommandHandler ..> IAppDbContext
RedeemSignInLinkCommandHandler ..> SignInLink : uses once
RedeemSignInLinkCommandHandler ..> Teammate : finds by the email's fingerprint, joined last
RedeemSignInLinkCommandHandler ..> SignInResultDto : returns
SignInTokens ..|> ISignInTokens
SignInMailOutbox ..|> ISignInMailOutbox
SignInMailDispatcher ..> SignInMailOutbox : drains
SignInMailDispatcher ..> ISignInEmailSender
PostmarkSignInEmailSender ..|> ISignInEmailSender
@enduml
