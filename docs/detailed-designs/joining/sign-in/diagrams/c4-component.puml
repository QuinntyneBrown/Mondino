@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in with an emailed link

Container_Boundary(web, "Mondino web app") {
  Component(page, "SignInPage", "Angular page, lazy route /sign-in", "The form, Check your inbox, and the opening of an emailed link")
  Component(store, "SignInStore", "Route-scoped service", "Holds the email and the SignInState")
  Component(client, "HttpSignInApi", "SignInApi, @mondino/api", "The only caller of the sign-in endpoints")
  Component(membership, "TeamMembership", "@mondino/domain, storage/", "Remembers the team after signing in")
}
Container_Boundary(api, "Mondino API") {
  Component(ctrl, "SignInController", "ASP.NET Core controller", "Open to anyone, rate limited")
  Component(request, "RequestSignInLinkCommandHandler", "MediatR handler", "Stores the link's hash and expiry, the same work whatever the email, and hands a teammate's mail to the outbox")
  Component(redeem, "RedeemSignInLinkCommandHandler", "MediatR handler", "Checks the link once, within 15 minutes, and finds the teammate")
  Component(tokens, "SignInTokens", "ISignInTokens", "Makes a token, hashes one, and seals the email with it")
  Component(outbox, "SignInMailOutbox", "ISignInMailOutbox, bounded channel", "Holds the mails until they are sent")
  Component(dispatcher, "SignInMailDispatcher", "Hosted service", "Drains the outbox into the sender")
  Component(sender, "PostmarkSignInEmailSender", "ISignInEmailSender", "Sends the link, 5 s timeout and a breaker")
  Component(session, "TeammateSessionHandler", "Cookie session authentication", "Issues the HttpOnly, Secure, SameSite cookie")
  ComponentDb(db, "Mondino database", "EF Core, IAppDbContext", "Sign-in links and teammates")
}
System_Ext(email, "Email source", "Postmark (ADR 0011)")

Rel(page, store, "requestLink(), open(signInToken)")
Rel(store, client, "requestLink, redeem")
Rel(page, membership, "remember(membership)")
Rel(client, ctrl, "POST sign-in-links, POST redemptions", "JSON/HTTPS")
Rel(ctrl, request, "RequestSignInLinkCommand", "MediatR")
Rel(ctrl, redeem, "RedeemSignInLinkCommand", "MediatR")
Rel(request, tokens, "Create()")
Rel(redeem, tokens, "Hash(token)")
Rel(request, outbox, "Enqueue(email, link)")
Rel(dispatcher, outbox, "Reads")
Rel(dispatcher, sender, "SendAsync(email, link)")
Rel(sender, email, "Address and link", "HTTPS, 5 s timeout")
Rel(request, db, "Adds the SignInLink", "EF Core")
Rel(redeem, db, "Marks the link used; reads the teammate by the email's fingerprint", "EF Core")
Rel(ctrl, session, "Signs the teammate in")
@enduml
