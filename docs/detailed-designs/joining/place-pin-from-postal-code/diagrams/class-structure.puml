@startuml
set namespaceSeparator none
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}

title Class structure — Place a pin from a postal code

package "mondino application" {
  class JoinStore {
    +name: WritableSignal<string>
    +countryCode: WritableSignal<string>
    +postalCode: WritableSignal<string>
    +lookupState: Signal<LookupState>
    +found: Signal<PostalCodeResult | null>
    +nameProblem: Signal<NameProblem | null>
    +postalCodeMissing: Signal<boolean>
    +lookUp(): void
    +clearFound(): void
  }
  class JoinPage
  class joinLookupMessage << (F,#D1E9FF) function >> {
    +(lookupState: LookupState, postalCode: string, country: Country): LookupMessage | null
  }
}
package "@mondino/components" {
  class PostalCodeField <<mo-postal-code-field>> {
    +value: string
    +country: Country
    +lookupState: LookupState
    +message: LookupMessage | null
    +invalid: boolean
    +valueChange: string
    +blurred: void
    +retry: void
  }
}
package "@mondino/api" {
  enum LookupState {
    Idle
    Locating
    Found
    NotFound
    Unavailable
    RateLimited
  }
  interface InviteApi {
    +lookUpPostalCode(inviteToken, countryCode, postalCode, signal): Promise<PostalCodeResult>
  }
  class PostalCodeResult {
    +city: City
    +weather: Weather | null
  }
  class Country {
    +code: string
    +name: string
    +postalCodeHint: string
  }
  class LookupMessage {
    +text: string
    +retryLabel: string | null
  }
}
package "Mondino.Application" {
  class LookUpPostalCodeQuery {
    +string InviteToken
    +string CountryCode
    +string PostalCode
  }
  class LookUpPostalCodeQueryValidator
  class LookUpPostalCodeQueryHandler {
    +Handle(query: LookUpPostalCodeQuery): Task<PostalCodeResultDto>
  }
  class PostalCodeResultDto {
    +CityDto City
    +WeatherDto? Weather
  }
  class PostalCodeResolver {
    +ResolveAsync(countryCode: string, postalCode: string, ct): Task<PostalCodeResolution>
  }
  class PostalCodeResolution {
    +PostalCodeLookupStatus Status
    +PostalCode? PostalCode
    +City? City
  }
  class PostalCodeFormats {
    +IReadOnlyList<PostalCodeFormat> Supported
    +TryNormalise(countryCode: string, value: string, out postalCode: PostalCode): bool
  }
  class PostalCodeFormat {
    +string CountryCode
    +string CountryName
    +Regex Pattern
    +string Hint
  }
  interface IPostalCodeLookup {
    +FindCityAsync(postalCode: PostalCode, ct): Task<PostalCodeLookupOutcome>
  }
  class PostalCodeLookupOutcome {
    +PostalCodeLookupStatus Status
    +City? City
  }
  enum PostalCodeLookupStatus {
    Found
    NotFound
    Unavailable
  }
  interface IWeatherSource {
    +GetCurrentAsync(position: Position, ct): Task<Weather?>
  }
}
package "Mondino.Domain" {
  class PostalCode {
    +string CountryCode
    +string Value
  }
  class City {
    +string Name
    +string Region
    +string CountryCode
    +Position Position
    +string TimeZoneId
  }
  class Weather {
    +double TemperatureC
    +WeatherCondition Condition
    +DateTimeOffset ObservedAt
  }
}
package "Mondino.Infrastructure" {
  class CachedPostalCodeLookup
  class PostalCodeLookupClient
  class CachedWeatherSource
  class OpenMeteoWeatherSource
}

JoinStore --> LookupState
JoinStore ..> InviteApi : INVITE_API
JoinPage --> JoinStore
JoinPage --> PostalCodeField : value, country, lookupState, message, invalid
JoinPage ..> joinLookupMessage : this screen's copy
joinLookupMessage ..> LookupMessage : builds
joinLookupMessage ..> Country : postalCodeHint
PostalCodeField ..> LookupMessage : renders
PostalCodeField ..> LookupState : shows
PostalCodeField ..> Country : the chosen country
InviteApi ..> PostalCodeResult : returns
LookUpPostalCodeQueryValidator ..> LookUpPostalCodeQuery : validates
LookUpPostalCodeQueryHandler ..> LookUpPostalCodeQuery : handles
LookUpPostalCodeQueryHandler ..> PostalCodeResolver : resolves the city
PostalCodeResolver ..> PostalCodeFormats : normalises with
PostalCodeResolver ..> IPostalCodeLookup : finds the city
PostalCodeResolver ..> PostalCodeResolution : returns
PostalCodeResolution --> PostalCodeLookupStatus
LookUpPostalCodeQueryHandler ..> IWeatherSource : reads the weather
LookUpPostalCodeQueryHandler ..> PostalCodeResultDto : builds
PostalCodeFormats *-- PostalCodeFormat
PostalCodeFormats ..> PostalCode : creates
IPostalCodeLookup ..> PostalCodeLookupOutcome : returns
PostalCodeLookupOutcome --> PostalCodeLookupStatus
PostalCodeLookupOutcome --> City
IWeatherSource ..> Weather : returns
CachedPostalCodeLookup ..|> IPostalCodeLookup
PostalCodeLookupClient ..|> IPostalCodeLookup
CachedPostalCodeLookup --> PostalCodeLookupClient : decorates
CachedWeatherSource ..|> IWeatherSource
OpenMeteoWeatherSource ..|> IWeatherSource
CachedWeatherSource --> OpenMeteoWeatherSource : decorates
@enduml
