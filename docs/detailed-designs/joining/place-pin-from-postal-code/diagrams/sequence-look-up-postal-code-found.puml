@startuml
title UML sequence behaviour — Look up a postal code that is found
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Person with an invite link" as actor
box "Frontend — Mondino web app" #E0F2FE
  participant "JoinPage" as page
  participant "JoinStore" as store
  participant "HttpInviteApi" as client
  participant "GlobeView" as globe
end box
box "Backend — Mondino API" #D1FADF
  participant "InvitesController" as controller
end box
box "Backend — Mondino Application and Domain" #ECFDF3
  participant "LookUpPostalCodeQueryHandler" as handler
  participant "PostalCodeResolver" as resolver
  participant "PostalCodeFormats" as formats
end box
box "Backend — Mondino Infrastructure" #FFF4E5
  database "Mondino database" as db
  participant "CachedPostalCodeLookup" as lookup
  participant "CachedWeatherSource" as weather
end box
participant "Postal code source" as postal
participant "Open-Meteo" as meteo
actor -> page : Leave the postal code field ("20121", Italy)
page -> store : lookUp()
store --> page : lookupState Locating
page --> actor : "Finding 20121…", button "Placing your pin…" disabled (L2-003)
store -> client : lookUpPostalCode(inviteToken, "IT", "20121", signal)
client -> controller : POST /api/invites/{inviteToken}/postal-code-lookups
controller -> controller : Apply the lookup rate limit policy
controller -> handler : Send LookUpPostalCodeQuery
handler -> db : Find the team by invite token
db --> handler : Team exists
handler -> resolver : ResolveAsync("IT", "20121")
resolver -> formats : TryNormalise("IT", "20121")
formats --> resolver : PostalCode, form matches (L2-003)
resolver -> lookup : FindCityAsync(postalCode)
alt cached
  lookup --> resolver : Found, City
else not cached
  lookup -> postal : Country and postal code only, with a timeout
  postal --> lookup : Municipality, or nearest named locality (L2-006)
  lookup --> resolver : Found, City with the city's own position (L2-006)
end
resolver --> handler : PostalCodeResolution: Found, PostalCode, City
handler -> weather : GetCurrentAsync(city position)
weather -> meteo : City position only, with a timeout
meteo --> weather : Current weather, or no answer
weather --> handler : Weather, or null when Open-Meteo fails
handler --> controller : PostalCodeResultDto
controller --> client : 200 PostalCodeResultDto
client --> store : PostalCodeResult
store --> page : lookupState Found
page -> page : joinLookupMessage(...) gives PostalCodeField its message
page -> globe : Turn to the city, add the pin "You" and the city, pulsing once
page --> actor : "Milan, Lombardy", pin placed at city level, weather, button "Join Northwind" (L2-003)
@enduml
