@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Place a pin from a postal code

Container(web, "Mondino web app", "Angular", "JoinPage, JoinStore, TextField, LookupMessage, CityField, HttpInviteApi, GlobeFallback")
Container_Boundary(api, "Mondino API") {
  Component(ctrl, "InvitesController", "ASP.NET Core controller", "Open to an invite link's holder, rate limited")
  Component(handler, "LookUpPostalCodeQueryHandler", "MediatR handler", "Checks the format, finds the city, reads the weather")
  Component(formats, "PostalCodeFormats", "Application service", "Per-country form, normalising and example")
  Component(lookup, "CachedPostalCodeLookup", "IPostalCodeLookup decorator", "Cache, timeout and circuit breaker")
  Component(lookupClient, "GeoNamesPostalCodeLookup", "HTTP client", "Maps the source's answer to a City")
  Component(weather, "CachedWeatherSource", "IWeatherSource decorator", "Cache, timeout and circuit breaker over OpenMeteoWeatherSource")
  Component(search, "SearchCitiesQueryHandler", "MediatR handler", "Searches the cities of a country while the lookup is down")
  Component(directory, "BundledCityDirectory", "ICityDirectory", "Mondino's own data set of cities")
  ComponentDb(db, "Mondino database", "EF Core, IAppDbContext", "Invite tokens")
}
System_Ext(postal, "Postal code source", "GeoNames postal code search (ADR 0006)")
System_Ext(meteo, "Open-Meteo", "Weather")

Rel(web, ctrl, "POST postal-code-lookups, POST city-searches", "JSON/HTTPS")
Rel(ctrl, handler, "Sends LookUpPostalCodeQuery")
Rel(ctrl, search, "Sends SearchCitiesQuery")
Rel(search, directory, "Search(countryCode, text, max)")
Rel(handler, db, "Checks the invite token", "EF Core")
Rel(handler, formats, "Normalises and checks the form")
Rel(handler, lookup, "FindCityAsync(postalCode)")
Rel(lookup, lookupClient, "On a cache miss")
Rel(lookupClient, postal, "Country and postal code", "HTTPS")
Rel(handler, weather, "GetCurrentAsync(position)")
Rel(weather, meteo, "City position", "HTTPS")
@enduml
