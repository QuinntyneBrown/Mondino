@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Place a pin from a postal code

Container(web, "Mondino web app", "Angular", "JoinPage, JoinStore, PostalCodeField, HttpInviteApi, GlobeView")
Container_Boundary(api, "Mondino API") {
  Component(ctrl, "InvitesController", "ASP.NET Core controller", "Open to an invite link's holder, rate limited")
  Component(handler, "LookUpPostalCodeQueryHandler", "MediatR handler", "Checks the invite token, resolves the city, reads the weather")
  Component(resolver, "PostalCodeResolver", "Application service", "Checks the form, finds the city and its time zone")
  Component(formats, "PostalCodeFormats", "Application service", "Per-country form, normalising and hint")
  Component(lookup, "CachedPostalCodeLookup", "IPostalCodeLookup decorator", "Cache, timeout and circuit breaker")
  Component(lookupClient, "PostalCodeLookupClient", "HTTP client", "Maps the source's answer to a City")
  Component(weather, "CachedWeatherSource", "IWeatherSource decorator", "Cache, timeout and circuit breaker over OpenMeteoWeatherSource")
  ComponentDb(db, "Mondino database", "EF Core, IAppDbContext", "Invite tokens")
}
System_Ext(postal, "Postal code source", "Provider TO SUPPLY")
System_Ext(meteo, "Open-Meteo", "Weather")

Rel(web, ctrl, "POST postal-code-lookups", "JSON/HTTPS")
Rel(ctrl, handler, "Sends LookUpPostalCodeQuery")
Rel(handler, db, "Checks the invite token", "EF Core")
Rel(handler, resolver, "ResolveAsync(countryCode, postalCode)")
Rel(resolver, formats, "Normalises and checks the form")
Rel(resolver, lookup, "FindCityAsync(postalCode)")
Rel(lookup, lookupClient, "On a cache miss")
Rel(lookupClient, postal, "Country and postal code", "HTTPS")
Rel(handler, weather, "GetCurrentAsync(position)")
Rel(weather, meteo, "City position", "HTTPS")
@enduml
