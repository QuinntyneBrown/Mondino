@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Stay fast and light

Person(teammate, "Teammate", "Enters and leaves the Globe screen")
Container_Boundary(spa, "Mondino web app") {
  Component(routes, "app.routes.ts", "Angular router configuration", "loadComponent for each screen")
  Component(page, "GlobePage", "Lazy route component", "Shows heading, counts and panel before the globe; defers the still picture")
  Component(view, "GlobeView", "Component in globe", "Imports the renderer dynamically; owns GlobeScene and DetailLevel for as long as it is on the page")
  Component(scene, "GlobeScene", "Class in globe", "Renderer, the low model first and the high one after, and the render loop; dispose releases all of it")
  Component(detail, "DetailLevel", "Class in globe", "Moves to the next lower detail step after 3 seconds under 30 frames a second")
  Component(clock, "BrowserClock", "Service in domain time/", "The one shared clock; rests while the tab is hidden")
  Component(store, "TeamStore", "Service in domain pins/", "Pins as signals; aborts a pending read when destroyed")
  Component(opener, "InviteDialogOpener", "Service provided by TeamShell", "Imports InviteDialog dynamically when Invite teammate is first chosen")
  Component(auth, "SignInPage, CreateTeamPage", "Lazy route components", "Chunks of their own, with their own API tokens and stores")
  Component(lists, "TeamTable, MomentList", "Presentation components", "A bounded number of rows: city sections of at most 50, and a window of 60 moments")
}
Rel(teammate, routes, "Opens /globe")
Rel(routes, page, "Loads the Globe chunk")
Rel(routes, auth, "Loads only when /sign-in or /new is opened")
Rel(teammate, opener, "Chooses Invite teammate")
Rel(page, view, "Places the globe beside its text")
Rel(view, scene, "Creates and disposes")
Rel(view, detail, "Reports frame times to")
Rel(view, clock, "Reads the night side's time from")
Rel(page, store, "Reads pins from")
Rel(page, clock, "Reads the minute tick from")
@enduml
