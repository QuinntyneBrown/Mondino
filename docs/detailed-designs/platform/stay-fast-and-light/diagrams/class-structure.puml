@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Stay fast and light

interface Clock {
  +now(): Date
  +minute: Signal<Date>
}

class BrowserClock {
  -timer: number | null
  -onVisibilityChange(): void
  -schedule(): void
  +now(): Date
  +minute: Signal<Date>
  +ngOnDestroy(): void
}

class TeamStore {
  +pins: Signal<Pin[]>
  +selectedTeammateId: Signal<string | null>
  +counts: Signal<TeamCounts>
  -pending: AbortController | null
  +refresh(): Promise<void>
  +select(teammateId: string | null): void
  +ngOnDestroy(): void
}

class GlobePage {
  +pins: Signal<Pin[]>
  +onSelect(teammateId: string): void
}

class GlobeView <<mo-globe>> {
  +pins: InputSignal<Pin[]>
  +selectedId: InputSignal<string | null>
  +interactive: InputSignal<boolean>
  +select: OutputEmitterRef<string | null>
  -scene: GlobeScene | null
  -resizeObserver: ResizeObserver
  -onDestroy(): void
}

class GlobeScene {
  -frameRequest: number | null
  {static} +create(canvas: HTMLCanvasElement, options: GlobeSceneOptions): Promise<GlobeScene>
  +onFrame(listener: (elapsedMs: number) => void): void
  +setDetail(step: DetailStep): void
  +start(): void
  +stop(): void
  +dispose(): void
}

class DetailLevel {
  +current: DetailStep
  +record(elapsedMs: number): DetailStep | null
}

class DetailStep {
  +pixelRatio: number
  +modelDetail: 'High' | 'Low'
}

class GlobeFallback <<mo-globe-fallback, components>> {
}

class TeamTable <<mo-team-table>> {
  +rows: InputSignal<TeamRow[]>
  at most CityRowLimit (50) rows per open city section
}

class MomentList <<mo-moment-list>> {
  +moments: InputSignal<Moment[]>
  a window of 60 rows past 60 moments (ADR 0021)
}

Clock <|.. BrowserClock
GlobePage ..> TeamStore : reads pins
GlobePage ..> Clock : reads minute
GlobePage ..> GlobeView : imports; it imports the renderer dynamically
GlobePage ..> GlobeFallback : @defer, only where WebGL is unavailable
GlobeView *-- GlobeScene : creates and disposes
GlobeView *-- DetailLevel : owns
GlobeView ..> Clock : injects CLOCK
DetailLevel --> DetailStep : current
@enduml
