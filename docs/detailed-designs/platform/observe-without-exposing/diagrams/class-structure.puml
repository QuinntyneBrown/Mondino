@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Observe without exposing

class MondinoTelemetry <<static>> {
  +{static} string ServiceName = "mondino-api"
  +{static} AddMondinoTelemetry(services, configuration): IServiceCollection
}

class SourceTelemetry {
  +{static} string Name = "Mondino"
  +ActivitySource Source
  -Counter<long> calls
  -Histogram<double> duration
  +Start(source: string): SourceCall
}

class SourceCall {
  +End(outcome: SourceOutcome): void
}

enum SourceOutcome {
  Success
  Failure
  Timeout
  CircuitOpen
}

class TelemetryRedaction <<static>> {
  +{static} AllowedSpanAttributes
  +{static} AllowedLogAttributes
  +{static} AllowedMetricTags
}

class SpanRedaction {
  +OnEnd(activity: Activity): void
}

class RouteTemplates <<static>> {
  +{static} Normalise(template: string): string
}

class LogRedaction {
  +OnEnd(record: LogRecord): void
}

class UnhandledExceptionHandler {
  +TryHandleAsync(context, exception, ct): ValueTask<bool>
}

class ProblemCodes <<static>> {
  +{static} Customize(context: ProblemDetailsContext): void
  -CorrelationId(context): string
}

class LogMessages <<static, source-generated>> {
  +UnhandledError(logger, errorType: string, correlationId: string): void
}

class HealthEndpoints <<static>> {
  +{static} AddMondinoHealth(services): IServiceCollection
  +{static} MapMondinoHealth(app): void
  GET /health/live
  GET /health/ready
}

class DatabaseReadyCheck {
  +CheckHealthAsync(context, ct): Task<HealthCheckResult>
}

class CachedPostalCodeLookup {
}
class CachedWeatherSource {
}
class CachedOpenHolidays {
}
class PostmarkSignInEmailSender {
}

SourceTelemetry ..> SourceCall : starts
SourceCall ..> SourceOutcome : labels by
MondinoTelemetry ..> SourceTelemetry : subscribes to "Mondino"
MondinoTelemetry ..> TelemetryRedaction : registers
TelemetryRedaction *-- SpanRedaction
TelemetryRedaction *-- LogRedaction
SpanRedaction ..> RouteTemplates : /api/teams/{teamId}/pins
CachedPostalCodeLookup ..> SourceTelemetry : Start("postal_code")
CachedWeatherSource ..> SourceTelemetry : Start("weather")
CachedOpenHolidays ..> SourceTelemetry : Start("holiday_calendar")
PostmarkSignInEmailSender ..> SourceTelemetry : Start("email")
UnhandledExceptionHandler ..> LogMessages : UnhandledError
UnhandledExceptionHandler ..> ProblemCodes : 500 with correlation id
HealthEndpoints ..> DatabaseReadyCheck : readiness
@enduml
