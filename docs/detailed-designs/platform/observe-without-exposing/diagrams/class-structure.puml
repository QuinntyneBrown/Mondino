@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Observe without exposing

class MondinoTelemetry {
  +{static} string ServiceName = "mondino-api"
  +ActivitySource Source
  +Meter Meter
  -Counter<long> sourceCalls
  -Histogram<double> sourceDuration
  +{static} AddMondinoTelemetry(services, configuration): void
  +RecordSourceCall(source: string, outcome: SourceOutcome, duration: TimeSpan): void
}

enum SourceOutcome {
  Success
  Failure
  Timeout
  CircuitOpen
}

class TelemetryRedaction {
  +{static} string[] AllowedSpanAttributes
  +OnEnd(activity: Activity): void
  +OnEnd(record: LogRecord): void
}

class UnhandledExceptionHandler {
  +TryHandleAsync(context, exception, ct): ValueTask<bool>
}

class ProblemDetailsWriter {
  +WriteAsync(context, status: int, code: string): Task
  -CorrelationId(context): string
}

class LogMessages <<static, source-generated>> {
  +TeammateJoined(logger): void
  +SourceCallFailed(logger, source: string, outcome: SourceOutcome): void
  +UnhandledError(logger, errorType: string, correlationId: string): void
}

class HealthEndpoints <<static>> {
  +{static} AddMondinoHealth(services): IServiceCollection
  +{static} MapMondinoHealth(app): void
  GET /health/live
  GET /health/ready
}

class DatabaseReadyCheck {
  +CheckHealthAsync(context, ct): Task<HealthCheckResult>
}

class CachedWeatherSource {
}
class CachedPostalCodeLookup {
}
class CachedMomentCalendars {
}

MondinoTelemetry ..> SourceOutcome : labels by
MondinoTelemetry *-- TelemetryRedaction : registers
CachedWeatherSource ..> MondinoTelemetry : RecordSourceCall
CachedPostalCodeLookup ..> MondinoTelemetry : RecordSourceCall
CachedMomentCalendars ..> MondinoTelemetry : RecordSourceCall
UnhandledExceptionHandler ..> LogMessages : UnhandledError
UnhandledExceptionHandler ..> ProblemDetailsWriter : 500 with correlation id
HealthEndpoints ..> DatabaseReadyCheck : readiness
@enduml
