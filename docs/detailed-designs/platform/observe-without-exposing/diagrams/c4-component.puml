@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Observe without exposing

Container_Boundary(api, "Mondino API") {
  Component(setup, "MondinoTelemetry", "OpenTelemetry setup, ActivitySource and Meter", "Registers instrumentation and the source instruments")
  Component(redaction, "TelemetryRedaction", "Span and log processor", "Keeps route templates; drops queries, bodies, addresses and outgoing URLs")
  Component(decorators, "Caching decorators", "CachedWeatherSource, CachedPostalCodeLookup, CachedMomentCalendars", "Record each call by source and outcome")
  Component(errors, "UnhandledExceptionHandler", "IExceptionHandler", "Logs the error's type and correlation id only")
  Component(problems, "ProblemDetailsWriter", "Error writer", "Adds the correlation id to ProblemDetails")
  Component(health, "Health endpoints", "/health/live and /health/ready", "Status only")
}
ContainerDb(db, "Mondino database", "EF Core", "Reachability checked for readiness")
System_Ext(telemetry, "Telemetry backend", "Product TO SUPPLY")
Rel(decorators, setup, "RecordSourceCall(source, outcome, duration)")
Rel(setup, redaction, "Passes each span and log record through")
Rel(redaction, telemetry, "Exports", "OTLP")
Rel(errors, problems, "Writes a 500 through")
Rel(errors, setup, "Logs through")
Rel(health, db, "Checks for readiness")
@enduml
