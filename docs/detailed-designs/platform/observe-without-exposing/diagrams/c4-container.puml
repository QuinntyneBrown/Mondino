@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Observe without exposing

Person(teammate, "Teammate", "Uses Mondino")

System_Boundary(mondino, "Mondino") {
  Container(spa, "Mondino web app", "Angular", "Sends no analytics or telemetry to anyone")
  Container(api, "Mondino API", "ASP.NET Core", "Instrumented with OpenTelemetry; health endpoints; correlation id in each error")
  ContainerDb(db, "Mondino database", "EF Core, engine TO SUPPLY", "Checked by the readiness endpoint")
}

System_Ext(telemetry, "Telemetry backend", "Product TO SUPPLY")
Rel(teammate, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, telemetry, "Exports traces, metrics and logs", "OTLP")
@enduml
