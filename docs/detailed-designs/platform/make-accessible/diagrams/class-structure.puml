@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Make accessible

interface MotionPreference {
  +reduced: Signal<boolean>
}

class BrowserMotionPreference {
  -query: MediaQueryList
  +reduced: Signal<boolean>
  -onChange(event: MediaQueryListEvent): void
}

class GlobeView <<mo-globe>> {
  +pins: InputSignal<Pin[]>
  +descriptions: InputSignal<Map<string, string>>
  +selectedId: InputSignal<string | null>
  +interactive: InputSignal<boolean>
  +label: InputSignal<string>
  +select: OutputEmitterRef<string>
}

class PinList {
  +pins: InputSignal<Pin[]>
  +descriptions: InputSignal<Map<string, string>>
  +selectedId: InputSignal<string | null>
  +select: OutputEmitterRef<string>
  +focused: OutputEmitterRef<string | null>
  -keys: FocusKeyManager<PinListItem>
  +onKeydown(event: KeyboardEvent): void
}

class PinListItem {
  +teammateId: string
  +description: string
  +focus(): void
}

class PinLayer {
  +lift(teammateId: string | null): void
  +showFocusRing(teammateId: string | null): void
}

class describePin <<function>> {
  +(pin: Pin, now: Date, settings: Settings): string
}

class GlobePage {
  +onSelect(teammateId: string): void
  -announceSelection(pin: Pin): void
}

class LiveAnnouncer <<Angular CDK>> {
  +announce(message: string, politeness: "polite"): Promise<void>
}

class AppShell <<mo-app-shell>> {
  +skipTarget: InputSignal<string>
}

class PostalCodeField <<mo-postal-code-field>> {
  +result: InputSignal<PostalCodeResult | null>
  +errorMessage: InputSignal<string | null>
}

MotionPreference <|.. BrowserMotionPreference
GlobeView *-- PinList
GlobeView *-- PinLayer
GlobeView ..> MotionPreference : reads
PinList "1" *-- "*" PinListItem
PinList ..> PinLayer : focused pin
GlobePage --> GlobeView : renders
GlobePage ..> describePin : calls
GlobePage ..> LiveAnnouncer : announces through
@enduml
