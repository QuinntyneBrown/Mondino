@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Make accessible

interface MotionPreference {
  +reduced: Signal<boolean>
}

class BrowserMotionPreference {
  -query: MediaQueryList
  +reduced: Signal<boolean>
  -onChange(event: MediaQueryListEvent): void
}

class GlobeView <<mo-globe>> {
  +pins: InputSignal<Pin[]>
  +descriptions: InputSignal<Map<string, string>>
  +selectedId: InputSignal<string | null>
  +interactive: InputSignal<boolean>
  +label: InputSignal<string>
  +select: OutputEmitterRef<string | null>
}

class PinLayer {
  +placements: InputSignal<PinPlacement[]>
  +descriptions: InputSignal<Map<string, string>>
  +selectedId: InputSignal<string | null>
  +select: OutputEmitterRef<string | null>
  +liftedId: Signal<string | null>
  one button per pin: aria-label, aria-pressed
}

class describePin <<function>> {
  +(pin: Pin, now: Date, settings: Settings): string
}

class GlobePage {
  +onSelect(teammateId: string): void
  +announcement: Signal<string>
  -announceSelection(pin: Pin): void
}

class App {
  skip link to the screen's main
}

class PostalCodeField <<mo-postal-code-field>> {
  +value: string
  +country: Country
  +lookupState: LookupState
  +message: LookupMessage | null
  +invalid: boolean
  +valueChange: string
  +blurred: void
  +retry: void
  message in a polite live region, or role=alert
  invalid sets aria-invalid
}

MotionPreference <|.. BrowserMotionPreference
GlobeView *-- PinLayer
GlobeView ..> MotionPreference : reads
GlobePage --> GlobeView : renders
GlobePage ..> describePin : calls
@enduml
