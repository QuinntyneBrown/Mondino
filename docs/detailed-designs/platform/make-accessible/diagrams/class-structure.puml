@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Make accessible

class GlobeMotion {
  +setReducedMotion(reduced: boolean): void
  +advance(elapsedMs: number): Orientation
}

class GlobeView <<mo-globe>> {
  +label: InputSignal<string>
  +interactive: InputSignal<boolean>
  +facing: InputSignal<Position | null>
  +blankTap: OutputEmitterRef<void>
  -reducedMotion: MediaQueryList
  [pins] slot
}

class PinLayer <<mo-pin-layer>> {
  +placements: InputSignal<PinPlacement[]>
  +selectedId: InputSignal<string | null>
  +selectPin: OutputEmitterRef<string>
  +selectGroup: OutputEmitterRef<PinPlacement>
  one button per pin: aria-label = description, aria-pressed
}

class describePin <<function>> {
  +(name, cityName, localTime, status, weather, marker): string
}

class GlobePage {
  #placements: Signal<PinPlacement[]>
  #announcement: Signal<string>
  polite live region: p[role=status]
}

class App {
  skip link to the screen's main
}

class PostalCodeField <<mo-postal-code-field>> {
  +value: string
  +country: Country
  +lookupState: LookupState
  +valueChange: string
  +blurred: void
}

GlobeView o-- PinLayer : [pins] slot
GlobeView *-- GlobeMotion : reduced motion
GlobePage --> GlobeView : renders
GlobePage --> PinLayer : places
GlobePage ..> describePin : through pinViews
@enduml
