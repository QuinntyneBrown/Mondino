@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Make accessible

Person(teammate, "Teammate", "Uses a keyboard or a screen reader")
Container_Boundary(spa, "Mondino web app") {
  Component(shell, "App", "Root component", "Skip to content link, first on every screen")
  Component(page, "GlobePage", "Lazy route component", "Selects a pin and announces the change once")
  Component(view, "GlobeView", "Component in globe, mo-globe", "Labelled group; hides the canvas from the accessibility tree; reads prefers-reduced-motion before it turns")
  Component(layer, "PinLayer", "Component in components", "The list of pins: one button per pin, named by its description; lifts the focused or selected pin")
  Component(describe, "describePin", "Function in domain pins/", "Name, city, local time, status, weather and moment as one sentence")
    Component(announcer, "Live region", "GlobePage's p[role=status][aria-live=polite]", "Says the selection once")
  Component(panel, "TeammatePanel", "Presentation component", "The selected teammate as text")
}
Rel(teammate, shell, "Tabs from the skip link")
Rel(teammate, layer, "Moves focus and selects with the keyboard")
Rel(view, layer, "Renders over the canvas, in its place in the accessibility tree")
Rel(page, describe, "Builds each pin's description with")
Rel(page, view, "Places PinLayer, with each pin's description, in its [pins] slot")
Rel(page, announcer, "Writes the selection into")
Rel(page, panel, "Shows the selected teammate in")
@enduml
