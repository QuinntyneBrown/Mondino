@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Adapt to every width

Person(teammate, "Teammate", "Opens a screen's address")
Person(visitor, "Person who is not a teammate", "Not a teammate of any team on this device")

System_Boundary(mondino, "Mondino") {
  Container(spa, "Mondino web app", "Angular", "Shell, navigation, lazy routes and the layout of each screen per breakpoint")
  Container(api, "Mondino API", "ASP.NET Core", "Answers a screen's requests for a teammate's session only")
  ContainerDb(db, "Mondino database", "EF Core, engine TO SUPPLY", "Teams, teammates and pins")
}

Rel(teammate, spa, "Uses at any width", "HTTPS")
Rel(visitor, spa, "Opens a screen's address", "HTTPS")
Rel(spa, api, "Reads the team for a teammate", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
