@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Adapt to every width

Person(teammate, "Teammate", "Opens a screen's address")
Container_Boundary(spa, "Mondino web app") {
  Component(routes, "app.routes.ts", "Angular router configuration", "One lazy route per screen under a guarded parent route")
  Component(guard, "teammateGuard", "CanMatchFn", "Lets a teammate through; anyone else is shown InviteNeededPage at the same address")
  Component(membership, "TeamMembership", "Service in domain storage/", "Team id, teammate id and team name held on the device")
  Component(app, "App", "Root component", "Skip link and the router outlet")
  Component(shell, "TeamShell", "Route component of the guarded parent", "Provides TeamStore; renders the header, the refresh banner, the four screens and the toast")
  Component(header, "AppHeader", "Presentation component, mo-app-header", "Mark and wordmark, navigation, Invite teammate and the link to Profile & Settings")
  Component(pages, "GlobePage, TeamPage, MomentsPage, ProfilePage", "Lazy route components", "One screen each, laid out by its own stylesheet")
  Component(needed, "InviteNeededPage", "Lazy route component", "Says an invite link is needed and shows no team data")
  Component(notfound, "NotFoundPage", "Lazy route component", "Says an address belongs to no screen and links back to the globe")
  Component(expired, "sessionExpiredInterceptor", "HttpInterceptorFn", "Forgets the membership when the API answers 401")
}
Rel(teammate, routes, "Opens an address")
Rel(routes, guard, "Runs to match a teammate screen")
Rel(guard, membership, "Reads")
Rel(routes, needed, "Loads at the same address for a non-teammate")
Rel(routes, notfound, "Loads for any other address")
Rel(routes, pages, "Loads with loadComponent")
Rel(app, shell, "Shows in its router outlet for a teammate")
Rel(shell, header, "Renders with navigation links and the viewer's avatar")
Rel(shell, pages, "Holds in its router outlet")
Rel(needed, header, "Renders without navigation")
Rel(expired, membership, "Clears on 401")
@enduml
