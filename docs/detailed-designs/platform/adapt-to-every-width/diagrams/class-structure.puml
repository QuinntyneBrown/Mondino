@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Adapt to every width

enum Breakpoint {
  ExtraSmall = under 576 px
  Small = 576 px
  Medium = 768 px
  Large = 992 px
  ExtraLarge = 1200 px
}

class App {
  skip link and router outlet
}

class TeamShell {
  +navItems: NavItem[]
  provides TeamStore, InviteLinkCopier and InviteDialogOpener
  renders the refresh banner and the toast
  +onInvite(trigger: HTMLElement): void
}

class NavItem {
  +label: string
  +path: string
}

class AppHeader <<mo-app-header>> {
  +showNavigation: InputSignal<boolean>
  +invite: OutputEmitterRef<void>
  slot nav
  slot me
}

class Wordmark <<mo-wordmark>> {
  +collapses: InputSignal<boolean>
}

class TeamMembership {
  +current: Signal<Membership | null>
  +remember(membership: Membership): void
  +forget(): void
}

class Membership {
  +teamId: string
  +teammateId: string
  +teamName: string
}

class teammateGuard <<CanMatchFn>> {
  +(route, segments): boolean
}

class sessionExpiredInterceptor <<HttpInterceptorFn>> {
  +(request, next): Observable<HttpEvent>
}

class InviteNeededPage {
}

class NotFoundPage {
}

class NoticePage <<mo-notice-page, components>> {
  +title: string
}

class TeamStore {
}

App ..> TeamShell : router outlet
TeamShell --> AppHeader : renders
TeamShell "1" *-- "3" NavItem
TeamShell ..> TeamStore : provides; reads the viewer's pin for the avatar
InviteNeededPage --> NoticePage : renders
NotFoundPage --> NoticePage : renders
NoticePage --> Wordmark : shows
AppHeader --> Wordmark : shows
AppHeader ..> Breakpoint : styled by
teammateGuard ..> TeamMembership : reads
teammateGuard ..> InviteNeededPage : shown when it refuses
sessionExpiredInterceptor ..> TeamMembership : forgets
TeamMembership --> Membership : holds
@enduml
