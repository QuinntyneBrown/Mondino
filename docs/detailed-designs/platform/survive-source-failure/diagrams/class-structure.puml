@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Survive source failure

interface IWeatherSource {
  +GetCurrentAsync(position: Position, ct): Task<Weather?>
}

interface IPostalCodeLookup {
  +FindCityAsync(postalCode: PostalCode, ct): Task<PostalCodeLookupOutcome>
}

interface IHolidayCalendar {
  +HolidaysIn(countryCode: string, from: DateOnly, to: DateOnly): Task<IReadOnlyList<CalendarEntry>>
}

class OpenMeteoWeatherSource {
  +GetCurrentAsync(position: Position, ct): Task<Weather?>
}

class CachedWeatherSource {
  -source: OpenMeteoWeatherSource
  -breaker: SourceBreaker
  -time: TimeProvider
  +{static} TimeSpan Timeout = 5 s
  +{static} TimeSpan FreshFor = 15 minutes
  +{static} TimeSpan ServedFor = 3 hours
  +GetCurrentAsync(position: Position, ct): Task<Weather?>
}

class GeoNamesPostalCodeLookup {
  +FindCityAsync(postalCode: PostalCode, ct): Task<PostalCodeLookupOutcome>
}

class CachedPostalCodeLookup {
  -source: GeoNamesPostalCodeLookup
  -breaker: SourceBreaker
  +FindCityAsync(postalCode: PostalCode, ct): Task<PostalCodeLookupOutcome>
}

class OpenHolidaysCalendar {
  +YearAsync(countryCode: string, year: int, ct): Task<IReadOnlyList<CalendarEntry>?>
}

class CachedOpenHolidays {
  -source: OpenHolidaysCalendar
  -breaker: SourceBreaker
  +{static} TimeSpan FreshFor = 24 hours
  +YearAsync(countryCode: string, year: int): Task<IReadOnlyList<CalendarEntry>>
}

class HolidayCalendar {
  +HolidaysIn(...): Task<IReadOnlyList<CalendarEntry>>
}

class SourceBreaker {
  +bool IsOpen
  +Succeeded()
  +Failed()
}

class OutsideSourceOptions {
  +int FailuresToOpen = 5
  +TimeSpan BreakerOpenFor = 30 s
}

class SourceDeadline {
  +{static} TimeSpan Limit = 6 s
  +Token: CancellationToken
}

class GetPinsQueryHandler {
  +Handle(query: GetPinsQuery, ct): Task<TeamPinsDto>
}

class PinDto {
  +string CityName
  +Position Position
  +string TimeZoneId
  +WeatherDto? Weather
  +WeatherState WeatherState
}

enum WeatherState {
  Available
  Unavailable
  NotShared
}

class Weather {
  +double TemperatureC
  +WeatherCondition Condition
  +DateTimeOffset ObservedAt
}

IWeatherSource <|.. OpenMeteoWeatherSource
IWeatherSource <|.. CachedWeatherSource
CachedWeatherSource o-- OpenMeteoWeatherSource : decorates
IPostalCodeLookup <|.. CachedPostalCodeLookup
CachedPostalCodeLookup o-- GeoNamesPostalCodeLookup : decorates
IHolidayCalendar <|.. HolidayCalendar
HolidayCalendar --> CachedOpenHolidays
CachedOpenHolidays o-- OpenHolidaysCalendar : decorates
CachedWeatherSource *-- SourceBreaker
CachedPostalCodeLookup *-- SourceBreaker
CachedOpenHolidays *-- SourceBreaker
SourceBreaker ..> OutsideSourceOptions : reads
SourceDeadline ..> IPostalCodeLookup : then
SourceDeadline ..> IWeatherSource : what is left of 6 s
GetPinsQueryHandler ..> IWeatherSource : once per city
GetPinsQueryHandler ..> PinDto : builds
PinDto --> WeatherState
IWeatherSource ..> Weather
@enduml
