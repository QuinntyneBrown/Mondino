@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Survive source failure

Person(teammate, "Teammate", "Reads the team")

System_Boundary(mondino, "Mondino") {
  Container(spa, "Mondino web app", "Angular", "Shows local time and status from the time zone; says where weather is unavailable; keeps its last data")
  Container(api, "Mondino API", "ASP.NET Core", "The only caller of outside sources: timeout, cache, circuit breaker")
  ContainerDb(db, "Mondino database", "EF Core, engine TO SUPPLY", "Each pin's city, position and time zone")
}

System_Ext(weather, "Open-Meteo", "Weather")
System_Ext(others, "Postal code, holiday, race and event sources", "Providers TO SUPPLY")
Rel(teammate, spa, "Uses", "HTTPS")
Rel(spa, api, "Reads pins and moments", "JSON/HTTPS")
Rel(api, db, "Reads", "EF Core")
Rel(api, weather, "Calls with a place only", "HTTPS, 5 s timeout")
Rel(api, others, "Calls with a place only", "HTTPS, 5 s timeout")
@enduml
