@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Survive source failure

Container_Boundary(api, "Mondino API") {
  Component(pins, "GetPinsQueryHandler", "MediatR handler", "Builds pins; asks for weather once per city")
  Component(moments, "GetMomentsQueryHandler", "MediatR handler", "Gathers moments of each kind independently")
  Component(cweather, "CachedWeatherSource", "Decorator of IWeatherSource", "Cache, 5 s timeout, circuit breaker; null when unavailable")
  Component(cpostal, "CachedPostalCodeLookup", "Decorator of IPostalCodeLookup", "Cache, 5 s timeout, circuit breaker")
  Component(ccal, "CachedOpenHolidays", "Decorator of the holiday source", "Cache, 5 s timeout, circuit breaker; the last year read while it fails")
  Component(own, "MondinoCalendar", "Embedded calendar", "Holidays, Formula 1, local events and sport; calls no one")
  Component(search, "SearchCitiesQueryHandler", "MediatR handler", "Serves the city search while the postal code lookup is down")
  Component(directory, "BundledCityDirectory", "ICityDirectory", "Mondino's own data set of cities; no outside source")
  Component(resilience, "SourceBreaker", "One per source", "5 failures in a row, then 30 s without a call (OutsideSources:*)")
  Component(clients, "OpenMeteoWeatherSource, GeoNamesPostalCodeLookup, OpenHolidaysCalendar", "HTTP clients", "Send a place and nothing else")
}
ContainerDb(db, "Mondino database", "EF Core", "City, position, time zone")
System_Ext(sources, "Outside sources", "Open-Meteo, GeoNames and OpenHolidays")
Rel(pins, db, "Loads teammates", "IAppDbContext")
Rel(pins, cweather, "Weather per distinct city", "IWeatherSource")
Rel(moments, ccal, "Public holidays", "IHolidayCalendar")
Rel(moments, own, "Moments of every kind", "IHolidayCalendar, IRaceCalendar, IEventCalendar")
Rel(search, directory, "Search(countryCode, text, max)", "ICityDirectory")
Rel(cweather, resilience, "Asks before a call")
Rel(cpostal, resilience, "Asks before a call")
Rel(ccal, resilience, "Asks before a call")
Rel(cweather, clients, "Calls within 5 s")
Rel(cpostal, clients, "Calls within 5 s")
Rel(ccal, clients, "Calls within 5 s")
Rel(clients, sources, "HTTPS")
@enduml
