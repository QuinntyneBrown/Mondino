@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
hide empty members
title Class structure — Protect team data

interface ICurrentTeammate {
  +Guid TeammateId
  +Guid TeamId
  +bool IsAuthenticated
}

class CurrentTeammate {
  +Guid TeammateId
  +Guid TeamId
  +bool IsAuthenticated
}

class TeammateSessionHandler {
  +HandleAuthenticateAsync(): Task<AuthenticateResult>
  +SignInAsync(teammate: Teammate): Task
  +SignOutAsync(): Task
}

interface ITeamScopedRequest {
  +Guid TeamId
}

class TeamScopeBehaviour<TRequest, TResponse> {
  +Handle(request, next, ct): Task<TResponse>
}

class AntiforgeryFilter {
  +OnAuthorizationAsync(context): Task
}

class AppShell {
  +ServeAsync(context: HttpContext): Task
}

class JoinTeamCommandValidator {
  Name: 1 to 60 characters
  CountryCode: in the supported list
  PostalCode: at most 12 characters
}

class NameNormaliser {
  +Normalise(name: string): string
}

class RateLimitPolicies {
  +{static} string Invite = 30 per minute
  +{static} string Lookup = 10 per minute
  +{static} string CitySearch = 30 per minute
  +{static} string Join = 5 per minute
  +{static} AddRateLimitPolicies(services): IServiceCollection
}

class SecurityHeadersMiddleware {
  +InvokeAsync(context: HttpContext): Task
}

class RefusalHandler {
  +TryHandleAsync(context, exception, ct): ValueTask<bool>
}

class PinDto {
  +Guid TeammateId
  +string Name
  +string CityName
  +string Country
  +Position Position
  +string TimeZoneId
  no postal code, no email
}

class ProfileDto {
  +string TeamName
  +PinDto Pin
  +string CountryCode
  +string? PostalCode
  settings: journeys 22 and 23
}

class GetPinsQuery {
  +Guid TeamId
}

class GetProfileQuery {
  +Guid TeamId
}

ICurrentTeammate <|.. CurrentTeammate
TeammateSessionHandler ..> CurrentTeammate : populates
TeamScopeBehaviour ..> ICurrentTeammate : compares TeamId
TeamScopeBehaviour ..> ITeamScopedRequest : applies to
ITeamScopedRequest <|.. GetPinsQuery
ITeamScopedRequest <|.. GetProfileQuery
TeamScopeBehaviour ..> RefusalHandler : team_not_found
JoinTeamCommandValidator ..> RefusalHandler : validation_failed
AntiforgeryFilter ..> RefusalHandler : cross_site_request
SecurityHeadersMiddleware ..> AppShell : gives the nonce to
JoinTeamCommandValidator ..> NameNormaliser : after
GetPinsQuery ..> PinDto : answers with, in a TeamPinsDto
GetProfileQuery ..> ProfileDto : answers the owner with
@enduml
